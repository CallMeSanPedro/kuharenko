<Window x:Class="WpfFeatureFlagsDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="450"
        Width="800">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0"
                Margin="0,0,0,12">
      <TextBlock FontSize="18"
                 FontWeight="SemiBold"
                 Text="Демо feature toggle в клиенте" />
      <TextBlock Margin="0,6,0,0"
                 Foreground="Gray"
                 Text="{Binding HintText}" />
    </StackPanel>

    <TabControl Grid.Row="1">
      <TabItem Header="Заказы"
               Visibility="{Binding IsOrdersTabVisible, Converter={StaticResource BoolToVisibilityConverter}}">
        <TextBlock Margin="16"
                   TextWrapping="Wrap"
                   Text="Основной функционал заказов доступен." />
      </TabItem>

      <TabItem Header="Отчеты"
               Visibility="{Binding IsReportsTabVisible, Converter={StaticResource BoolToVisibilityConverter}}">
        <TextBlock Margin="16"
                   TextWrapping="Wrap"
                   Text="Вкладка отчетов включается/выключается флагом Tab.Reports." />
      </TabItem>

      <TabItem Header="Администрирование"
               Visibility="{Binding IsAdminTabVisible, Converter={StaticResource BoolToVisibilityConverter}}">
        <TextBlock Margin="16"
                   TextWrapping="Wrap"
                   Text="Вкладка администрирования включается/выключается флагом Tab.Admin." />
      </TabItem>
    </TabControl>
  </Grid>
</Window>
