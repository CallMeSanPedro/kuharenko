<!-- Вставить кнопки в bordertoolbar_row1 сразу после кнопки SelFromFileCommand.
     Кнопки видны только в форме, открытой с IdentifierChangeMode="True". -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:controls="clr-namespace:Store.Views.Controls"
            Orientation="Horizontal"
            Visibility="{Binding Path=ShowIdentifierChange, Converter={x:Static controls:BoolToVisibilityConverter.Instance}}">
    <Button Margin="3"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Command="{Binding Path=DownloadIdentifierTemplateCommand}"
            ToolTipService.ToolTip="Скачать шаблон смены идентификаторов"
            ContentTemplate="{StaticResource IconExcelTemplate}"
            Style="{StaticResource ButtonChromelessStyle}"/>
    <Button Margin="3"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Command="{Binding Path=LoadIdentifierChangeCommand}"
            ToolTipService.ToolTip="Загрузить файл смены идентификаторов"
            ContentTemplate="{StaticResource IconFromFolderTemplate}"
            Style="{StaticResource ButtonChromelessStyle}"/>
    <Button Margin="3"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Command="{Binding Path=VerifyIdentifierChangeCommand}"
            ToolTipService.ToolTip="Проверить смену идентификаторов"
            Content="Проверить"
            Style="{StaticResource ButtonChromelessStyle}"/>
</StackPanel>
