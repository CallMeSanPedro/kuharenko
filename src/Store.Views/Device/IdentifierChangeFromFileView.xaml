<Controls:UserView x:Class="Store.Views.Device.IdentifierChangeFromFileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:Controls="clr-namespace:DatumNode.Controls;assembly=DatumNode.Controls"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    xmlns:controls="clr-namespace:Store.Views.Controls"
    xmlns:device="clr-namespace:Store.ViewModels.Device;assembly=Store.ViewModels"
    xmlns:ownerships="clr-namespace:Store.ViewModels.Ownerships;assembly=Store.ViewModels"
    xmlns:reference="clr-namespace:Store.ViewModels.Reference;assembly=Store.ViewModels"
    MinViewWidth="600"
    MinViewHeight="420"
    StretchDialog="WidthAndHeight"
    d:DataContext="{d:DesignInstance device:IdentifierChangeFromFileViewModel}">

    <Controls:UserView.Resources>
        <Controls:DataContextProxy x:Key="DataContextProxy"/>
        <Controls:DataContextProxy x:Key="OwnershipViewModel">
            <Controls:DataContextProxy.ViewModel>
                <ownerships:OwnershipViewModel/>
            </Controls:DataContextProxy.ViewModel>
        </Controls:DataContextProxy>
        <Controls:DataContextProxy x:Key="DeviceConditionViewModel">
            <Controls:DataContextProxy.ViewModel>
                <reference:DeviceConditionViewModel/>
            </Controls:DataContextProxy.ViewModel>
        </Controls:DataContextProxy>
        <Controls:DataContextProxy x:Key="EthTechStatRefViewModel">
            <Controls:DataContextProxy.ViewModel>
                <reference:EthTechStatRefViewModel/>
            </Controls:DataContextProxy.ViewModel>
        </Controls:DataContextProxy>
    </Controls:UserView.Resources>

    <xctk:BusyIndicator x:Name="BusyIndicator"
                        IsBusy="{Binding Source={StaticResource DataContextProxy}, Path=DataSource.IsBusy, Mode=TwoWay}"
                        BusyContent="{Binding Path=BusyMessage}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
        <Border Style="{StaticResource MainContentBorders}" x:Name="MainBorder" Margin="3" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Grid Name="Main">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource MainContentBorders}" BorderThickness="1" Margin="3" Name="bordertoolbar">
                    <StackPanel Orientation="Horizontal">
                        <Button Margin="3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Command="{Binding Path=DownloadIdentifierTemplateCommand}"
                                ToolTipService.ToolTip="Скачать шаблон смены идентификаторов"
                                ContentTemplate="{StaticResource IconExcelTemplate}"
                                Style="{StaticResource ButtonChromelessStyle}"/>
                        <Button Margin="3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Command="{Binding Path=LoadIdentifierChangeCommand}"
                                ToolTipService.ToolTip="Загрузить файл смены идентификаторов"
                                ContentTemplate="{StaticResource IconFromFolderTemplate}"
                                Style="{StaticResource ButtonChromelessStyle}"/>
                        <Button Margin="3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Command="{Binding Path=VerifyIdentifierChangeCommand}"
                                ToolTipService.ToolTip="Проверить все строки файла"
                                Content="Проверить"
                                Style="{StaticResource ButtonChromelessStyle}"/>
                        <Border Style="{StaticResource SeparatorStyle}"/>
                        <CheckBox Content="Пропустить первую строку"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding Path=SkipFirstRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="1" Padding="4,1,0,0"/>
                    </StackPanel>
                </Border>

                <TabControl Grid.Row="1" Margin="3"
                            SelectedIndex="{Binding Path=LoadModeIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <TabItem Header="Смена идентификаторов">
                        <TextBlock Margin="6" TextWrapping="Wrap"
                                   Text="Меняются SN, MAC и PON из файла. Форма владения, состояние и тех. состояние не заполняются и на проверку не передаются. Экземпляр должен быть в статусе «на складе» и на складе документа."/>
                    </TabItem>
                    <TabItem Header="Смена параметров">
                        <StackPanel Margin="3">
                            <TextBlock Margin="3" TextWrapping="Wrap"
                                       Text="Форма владения, состояние и тех. состояние задаются один раз для всех строк. Новые SN, MAC и PON из файла не проверяются. Для «Собственность абонента» нужен статус «у абонента», для остальных форм — статус «на складе» и склад документа."/>
                            <StackPanel Orientation="Horizontal">
                                <Controls:Label VerticalAlignment="Center" Margin="3" Content="Форма владения"/>
                                <Controls:ComboBox Margin="3" Width="180" x:Name="Ownership"
                                                   ItemsSource="{Binding Source={StaticResource OwnershipViewModel}, Path=ViewModel.ItemsView}"
                                                   SelectedItem="{Binding Path=Ownership, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true, UpdateSourceTrigger=PropertyChanged}"
                                                   IsEnabled="{Binding Path=CanSelectOwnerschip}"/>
                                <Controls:Label VerticalAlignment="Center" Margin="3" Content="Состояние"/>
                                <Controls:ComboBox Margin="3" Width="180" x:Name="DeviceCondition"
                                                   ItemsSource="{Binding Source={StaticResource DeviceConditionViewModel}, Path=ViewModel.ItemsView}"
                                                   SelectedItem="{Binding Path=DeviceCondition, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true, UpdateSourceTrigger=PropertyChanged}"/>
                                <Controls:Label VerticalAlignment="Center" Margin="3" Content="Тех. состояние"/>
                                <Controls:ComboBox Margin="3" Width="180" x:Name="EthTechStatRef"
                                                   ItemsSource="{Binding Source={StaticResource EthTechStatRefViewModel}, Path=ViewModel.ItemsView}"
                                                   SelectedItem="{Binding Path=EthTechStatRef, Mode=TwoWay, ValidatesOnExceptions=true, NotifyOnValidationError=true, UpdateSourceTrigger=PropertyChanged}"
                                                   IsEnabled="{Binding Path=CanSelectTechStat}"/>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                </TabControl>

                <Controls:DataGrid Grid.Row="2"
                                   Name="cdgIdentifierChange"
                                   Margin="3"
                                   IsReadOnly="True"
                                   AutoGenerateColumns="True"
                                   Reflection="True"
                                   IgnoreParamList="{Binding Path=IdentifierChangeIgnoreParamList, Mode=OneWay}"
                                   ItemsSource="{Binding Path=IdentifierChangeItems, Mode=TwoWay}"
                                   SelectedItem="{Binding Path=IdentifierChangeCurrent, Mode=TwoWay}"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto"
                                   MinHeight="326"
                                   SelectionMode="Single">
                    <Controls:DataGrid.Columns>
                        <DataGridTemplateColumn Width="36" IsReadOnly="False" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl IsEnabled="{Binding Path=CanAddBool, Mode=OneWay, TargetNullValue=True}">
                                        <CheckBox IsChecked="{Binding Path=ChBoxS, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsThreeState="False"
                                                  Command="{Binding Source={StaticResource DataContextProxy}, Path=DataSource.IdentifierChangeChBoxCommand}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Padding="0"
                                                  ToolTip="Выбор строки для загрузки"/>
                                    </ContentControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <CheckBox IsThreeState="True"
                                                          IsChecked="{Binding Source={StaticResource DataContextProxy}, Path=DataSource.IdentifierChangeAllChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Command="{Binding Source={StaticResource DataContextProxy}, Path=DataSource.IdentifierChangeChBoxAllCommand}"
                                                          Margin="2,1,0,1"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Padding="0"/>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                        </DataGridTemplateColumn>
                    </Controls:DataGrid.Columns>
                </Controls:DataGrid>

                <Grid Grid.Row="3" Margin="3"
                      Visibility="{Binding Path=ShowResume, Converter={x:Static controls:BoolToVisibilityConverter.Instance}, TargetNullValue=Collapsed}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Controls:Label Grid.Column="0" Margin="3" Content="Резюме"/>
                    <TextBox Grid.Column="1"
                             Margin="3"
                             x:Name="result"
                             Text="{Binding Path=ResumeText, Mode=OneWay}"
                             AcceptsReturn="True"
                             IsReadOnly="True"/>
                </Grid>
            </Grid>
        </Border>
    </xctk:BusyIndicator>
</Controls:UserView>
