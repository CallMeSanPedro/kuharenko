<!-- Поставить в Grid Name="Table", строка 2, рядом с cdgDeviceList.
     У cdgDeviceList и кнопок приёмки в bordertoolbar_row1 добавить
     Visibility="{Binding Path=ShowFileLoad, Converter={x:Static controls:BoolToVisibilityConverter.Instance}}". -->
<Controls:DataGrid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:Controls="clr-namespace:DatumNode.Controls;assembly=DatumNode.Controls"
                   xmlns:controls="clr-namespace:Store.Views.Controls"
                   Grid.Row="2"
                   Name="cdgIdentifierChange"
                   IsReadOnly="True"
                   AutoGenerateColumns="True"
                   Reflection="True"
                   ItemsSource="{Binding Path=IdentifierChangeItems, Mode=OneWay}"
                   Visibility="{Binding Path=ShowIdentifierChange, Converter={x:Static controls:BoolToVisibilityConverter.Instance}}"
                   HorizontalScrollBarVisibility="Auto"
                   VerticalScrollBarVisibility="Auto"
                   MinHeight="326"
                   SelectionMode="Single">
    <Controls:DataGrid.Columns>
        <DataGridTemplateColumn Width="36" IsReadOnly="False" CanUserSort="False">
            <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                    <ContentControl IsEnabled="{Binding Path=CanAddBool, Mode=OneWay, TargetNullValue=True}">
                        <CheckBox IsChecked="{Binding Path=ChBoxS, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsThreeState="False"
                                  Command="{Binding Source={StaticResource DataContextProxy}, Path=DataSource.IdentifierChangeChBoxCommand}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Padding="0"
                                  ToolTip="Выбор строки для загрузки"/>
                    </ContentControl>
                </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
    </Controls:DataGrid.Columns>
</Controls:DataGrid>
