<!-- Поставить в Grid Name="Table", строка 2. Пока ShowIdentifierChange=true, грид приёмки cdgDeviceList нужно скрыть. -->
<Controls:DataGrid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:Controls="clr-namespace:DatumNode.Controls;assembly=DatumNode.Controls"
                   xmlns:controls="clr-namespace:Store.Views.Controls"
                   Grid.Row="2"
                   Name="cdgIdentifierChange"
                   IsReadOnly="True"
                   AutoGenerateColumns="False"
                   ItemsSource="{Binding Path=IdentifierChangeItems, Mode=OneWay}"
                   Visibility="{Binding Path=ShowIdentifierChange, Converter={x:Static controls:BoolToVisibilityConverter.Instance}}"
                   HorizontalScrollBarVisibility="Auto"
                   VerticalScrollBarVisibility="Auto"
                   MinHeight="326"
                   SelectionMode="Single">
    <Controls:DataGrid.Columns>
        <DataGridTextColumn IsReadOnly="True" Binding="{Binding Path=LineNumber}" Width="auto" Header="Строка"/>
        <DataGridTemplateColumn>
            <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding Path=ChBoxS, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding Path=CanApply}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn IsReadOnly="True" Binding="{Binding Path=SerialNumberCurrent}" Width="auto" MaxWidth="250" Header="SN текущий"/>
        <DataGridTextColumn IsReadOnly="True" Binding="{Binding Path=MacCurrent}" Width="auto" MaxWidth="250" Header="MAC текущий"/>
        <DataGridTextColumn IsReadOnly="True" Binding="{Binding Path=PonCurrent}" Width="auto" MaxWidth="250" Header="PON текущий"/>
        <DataGridTextColumn IsReadOnly="True" Binding="{Binding Path=SerialNumberNew}" Width="auto" MaxWidth="250" Header="SN новый"/>
        <DataGridTextColumn IsReadOnly="True" Binding="{Binding Path=MacNew}" Width="auto" MaxWidth="250" Header="MAC новый"/>
        <DataGridTextColumn IsReadOnly="True" Binding="{Binding Path=PonNew}" Width="auto" MaxWidth="250" Header="PON новый"/>
        <DataGridTextColumn IsReadOnly="True" Binding="{Binding Path=Error}" Width="*" MaxWidth="1000" Header="Ошибка"/>
    </Controls:DataGrid.Columns>
</Controls:DataGrid>
