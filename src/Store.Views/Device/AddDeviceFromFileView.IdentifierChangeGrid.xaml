<!-- Поставить в Grid Name="Table", строка 2. Пока ShowIdentifierChange=true, грид приёмки cdgDeviceList нужно скрыть. -->
<Controls:DataGrid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:Controls="clr-namespace:DatumNode.Controls;assembly=DatumNode.Controls"
                   xmlns:controls="clr-namespace:Store.Views.Controls"
                   Grid.Row="2"
                   Name="cdgIdentifierChange"
                   IsReadOnly="True"
                   AutoGenerateColumns="False"
                   ItemsSource="{Binding Path=IdentifierChangeItems, Mode=OneWay}"
                   Visibility="{Binding Path=ShowIdentifierChange, Converter={x:Static controls:BoolToVisibilityConverter.Instance}}"
                   HorizontalScrollBarVisibility="Auto"
                   VerticalScrollBarVisibility="Auto"
                   MinHeight="326"
                   SelectionMode="Single">
    <Controls:DataGrid.Columns>
        <DataGridTextColumn IsReadOnly="True" Binding="{Binding Path=LineNo}" Width="auto" Header="Строка"/>
        <DataGridTextColumn IsReadOnly="True" Binding="{Binding Path=SerialNumber}" Width="auto" MaxWidth="250" Header="SN текущий"/>
        <DataGridTextColumn IsReadOnly="True" Binding="{Binding Path=MacAddress}" Width="auto" MaxWidth="250" Header="MAC текущий"/>
        <DataGridTextColumn IsReadOnly="True" Binding="{Binding Path=PonSerial}" Width="auto" MaxWidth="250" Header="PON текущий"/>
        <DataGridTextColumn IsReadOnly="True" Binding="{Binding Path=NewSerialNumber}" Width="auto" MaxWidth="250" Header="SN новый"/>
        <DataGridTextColumn IsReadOnly="True" Binding="{Binding Path=NewMacAddress}" Width="auto" MaxWidth="250" Header="MAC новый"/>
        <DataGridTextColumn IsReadOnly="True" Binding="{Binding Path=NewPonSerial}" Width="auto" MaxWidth="250" Header="PON новый"/>
        <DataGridTextColumn IsReadOnly="True" Binding="{Binding Path=CommId}" Width="auto" Header="Карточка"/>
        <DataGridTextColumn IsReadOnly="True" Binding="{Binding Path=CardMacAddress}" Width="auto" MaxWidth="250" Header="MAC на карточке"/>
        <DataGridTextColumn IsReadOnly="True" Binding="{Binding Path=CardPonSerial}" Width="auto" MaxWidth="250" Header="PON на карточке"/>
        <DataGridTextColumn IsReadOnly="True" Binding="{Binding Path=VerifyStatusStr}" Width="*" MaxWidth="1000" Header="Результат"/>
    </Controls:DataGrid.Columns>
</Controls:DataGrid>
