                                                           SelectedItem="{Binding Path=Filter.ExploitStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                           Width="100"
                                                           ItemsSource="{Binding Source={StaticResource ExploitStatusViewModel}, Path=ItemsView}"/>
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
