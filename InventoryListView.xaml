                             SelectedItem="{Binding Path=Filter.TechSost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             Width="100"
                             ItemsSource="{Binding Source={StaticResource EthTechStatRefViewModel}, Path=ItemsView}"/>
                    </StackPanel>

           

                    <Button ContentTemplate="{StaticResource IconEraserTemplate}" 
                            Style="{StaticResource ButtonChromelessStyle}"
                            Grid.Column="3" Margin="3" HorizontalAlignment="Right" 
                            VerticalAlignment="Bottom" ToolTipService.ToolTip="Сбросить фильтр" 
