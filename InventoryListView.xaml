                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">

                    <StackPanel Orientation="Vertical">
                        <Controls3:Label  Margin="5,1,1,1" Content="МОЛ" HorizontalAlignment="Left" />
                        <TextBox  Margin="3" Width="100" Text="{Binding Path=Filter.ResponsibleName, Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" KeyDown="QuickSearch"/>
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <Controls3:Label  Margin="5,1,1,1" Content="Модель" HorizontalAlignment="Left" />
                        <TextBox Margin="3" Width="120" Text="{Binding Path=Filter.EquipMarkaName, Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" KeyDown="QuickSearch"/>
                    </StackPanel>

                    --><!--<StackPanel Orientation="Vertical">
                        <Controls3:Label  Margin="5,1,1,1" Content="Код ТОУ" HorizontalAlignment="Left" />
