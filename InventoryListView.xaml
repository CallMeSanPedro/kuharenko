<Controls3:UserView x:Class="Store.Views.Device.InventoryListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Controls3="clr-namespace:DatumNode.Controls;assembly=DatumNode.Controls"
    xmlns:input="clr-namespace:System.Windows.Input;assembly=DatumNode.Controls"
    xmlns:reference="clr-namespace:Store.ViewModels.Reference;assembly=Store.ViewModels"
    xmlns:reference1="clr-namespace:Store.Models.Reference;assembly=Store.Models"
    xmlns:controls="clr-namespace:Store.Views.Controls"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:extensions="clr-namespace:Store.Views.Controls.Extensions"
    xmlns:warranty="clr-namespace:Store.ViewModels.Reference.Warranty;assembly=Store.ViewModels"
    xmlns:warranty1="clr-namespace:Store.Models.Reference.Warranty;assembly=Store.Models"
    xmlns:filtering="clr-namespace:Store.Views.Filtering"
                    xmlns:controls1="clr-namespace:Store.Views.Controls" xmlns:device="clr-namespace:Store.ViewModels.Device;assembly=Store.ViewModels" xmlns:b="http://schemas.microsoft.com/xaml/behaviors" d:DataContext="{d:DesignInstance device:InventoryListViewModel}"
                    mc:Ignorable="d"
    d:DesignHeight="300" d:DesignWidth="700" xmlns:loc="clr-namespace:Store.Views.Localization">

    <Controls3:UserView.Resources>
         <Controls3:DataContextProxy x:Key="DataContextProxy"/>

        <extensions:DataGridExport x:Key="DataGridExport"/>

        <reference:ExploitStatusViewModel x:Key="ExploitStatusViewModel">
            <reference:ExploitStatusViewModel.FirstItem>
                <reference1:ExploitStatus/>
            </reference:ExploitStatusViewModel.FirstItem>
        </reference:ExploitStatusViewModel>

        <reference:DeviceConditionViewModel x:Key="DeviceConditionViewModel">
            <reference:DeviceConditionViewModel.FirstItem>
                <reference1:DeviceCondition/>
            </reference:DeviceConditionViewModel.FirstItem>
        </reference:DeviceConditionViewModel>

        <reference:StoreCustomerSegmentsViewModel x:Key="StoreCustomerSegmentsViewModel">
            <reference:StoreCustomerSegmentsViewModel.FirstItem>
                <reference1:StoreCustomerSegments/>
            </reference:StoreCustomerSegmentsViewModel.FirstItem>
        </reference:StoreCustomerSegmentsViewModel>

        <reference:EthTechStatRefViewModel x:Key="EthTechStatRefViewModel">
            <reference:EthTechStatRefViewModel.FirstItem>
                <reference1:EthTechStatRef/>
            </reference:EthTechStatRefViewModel.FirstItem>
        </reference:EthTechStatRefViewModel>

        <warranty:DeviceTypeViewModel x:Key="DeviceTypeViewModel">
            <warranty:DeviceTypeViewModel.FirstItem>
                <warranty1:DeviceType/>
            </warranty:DeviceTypeViewModel.FirstItem>
        </warranty:DeviceTypeViewModel>


        <Style x:Key="SeparatorStyle"
           TargetType="Border">
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
            <Setter Property="BorderBrush" Value="#FFC5C5C5"/>
            <Setter Property="Margin" Value="3,3,2,3"/>
            <Setter Property="Width" Value="2"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Controls3:UserView.Resources>    

            <Grid Name="Main" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="100*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="1">

            <Border BorderBrush="#FFC5C5C5" BorderThickness="1" Margin="0,3,0,3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" >
                    <RadioButton Content="{loc:Tr Ui_SummaryData, Fallback='Сводные данные'}" Width="140"
                     Style="{DynamicResource ModeButtonStyle}"
                     IsChecked="{Binding ListMode.ShowBalance, Mode=TwoWay}"/>
                    <Border Width="1" Background="#FFC5C5C5"/>
                    <RadioButton Content="{loc:Tr Ui_Details, Fallback='Детализация'}" Width="140"
                     Style="{DynamicResource ModeButtonStyle}"
                     IsChecked="{Binding ListMode.ShowSerials, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <!--<RadioButton Content="Остатки"
                 GroupName="StoreDeviceMode"
                 IsChecked="{Binding ShowBalance, Mode=TwoWay}"
                 Style="{DynamicResource ModeButtonStyle}"/>
            <RadioButton Content="Серийные"
                 GroupName="StoreDeviceMode"
                 IsChecked="{Binding ShowSerials, Mode=TwoWay}"
                 Style="{DynamicResource ModeButtonStyle}"/>-->


            <Border Style="{StaticResource SeparatorStyle}"/>
            <StackPanel >
                <TextBox   Name="SearchText"                      
                     Margin="0,3"
                     Width="200" Height="27"
                     Text="{Binding Path=FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource TextBoxSearchStyle}"
                     mah:TextBoxHelper.Watermark="{loc:Tr Ui_Search, Fallback='Поиск'}"
                     mah:TextBoxHelper.ClearTextButton="True"/>
            </StackPanel>
            <Border Style="{StaticResource SeparatorStyle}" />
            <Controls3:Toolbar CanDelete="False" CanUpdate="False"  CanInsert="False" />
            <Border Style="{StaticResource SeparatorStyle}"/>

            <Button  ContentTemplate="{StaticResource IconExcelTemplate}" 
                     Style="{StaticResource ButtonChromelessStyle}"
                     HorizontalAlignment="Left" ToolTipService.ToolTip="{loc:Tr Ui_Export, Fallback='Экспорт'}"
                     Margin="3"
                     Command="{Binding Source={StaticResource DataGridExport}, Path=ExportDataGridCommand, UpdateSourceTrigger=PropertyChanged}"
                     CommandParameter="{Binding Source={x:Reference cdgInventory}}">
            </Button>
            <Button  ContentTemplate="{StaticResource IconPrinterTemplate}" 
                     Style="{StaticResource ButtonChromelessStyle}"
                     Margin="3"
                     HorizontalAlignment="Left" 
                     ToolTipService.ToolTip="{loc:Tr Ui_Print, Fallback='Печать'}"
                     Command="{Binding Path=ReportExportCommand, UpdateSourceTrigger=PropertyChanged}">
            </Button>
            <Border Style="{StaticResource SeparatorStyle}"/>
            <!--<Button   Margin="3" Content="Найти" Width="75" ToolTipService.ToolTip="Поиск" Command="{Binding Path=MySearchCommand}">
                --><!--<Image Margin="2" HorizontalAlignment="Center" VerticalAlignment="Center" Source="/Store.Views;component/Images/Find_60x16.png" Width="60" Height="16"/>--><!--
            </Button>-->


            <!--<Border Style="{StaticResource SeparatorStyle}"/>--> 
        </StackPanel>
        <ContentControl Grid.Row="2" Content="{Binding}" ContentTemplate="{StaticResource HeaderFilterSummaryTemplate}"/>
        <Controls3:DataGrid Grid.Row="3" IsReadOnly="True" Name="cdgInventory"
                                  AutoGenerateColumns="True" 
                                  ItemsSource="{Binding Path=ItemsView}" 
                                  filtering:ColumnCheckFilterBehavior.IsEnabled="True"
                                  filtering:ColumnCheckFilterBehavior.HeaderTemplate="{StaticResource ColumnFilterHeaderTemplate}"
                                  SelectionMode="Single"
                                  MouseDoubleClick="cdgInventory_MouseDoubleClick"
                                  HiddenColumns="{Binding Path=IgoreParamList}"
                                  SelectedItem="{Binding Path=CurrentItem, Mode=TwoWay}"
                                  RowDetailsVisibilityMode="VisibleWhenSelected"
                                  IsVisibleChanged="cdgInventory_IsVisibleChanged"
                                  AutoGeneratingColumn="cdgInventory_AutoGeneratingColumn">
            <Controls3:DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border BorderBrush="#E2E8F0"
                            BorderThickness="0,1,0,0"
                            Background="#F8FAFC"
                            Padding="12,8">
                        <Grid HorizontalAlignment="Left"
                              MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Controls3:DataGrid}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Left"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Foreground="#334155"
                                           VerticalAlignment="Center">
                                    <Run Text="Серийные номера ("/>
                                    <Run Text="{Binding Count, StringFormat={}{0:0}, TargetNullValue=0}"/>
                                    <Run Text=")"/>
                                </TextBlock>

                                <TextBlock DockPanel.Dock="Left"
                                           Margin="8,0,16,0"
                                           FontSize="11"
                                           Foreground="#64748B"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding HasPreviewTruncated, Converter={x:Static controls:BoolToVisibilityConverter.Instance}}">
                                    <Run Text="(показаны первые "/>
                                    <Run Text="{Binding LoadedSerialCount}"/>
                                    <Run Text=")"/>
                                </TextBlock>

                                <Button DockPanel.Dock="Right"
                                        Margin="16,0,0,0"
                                        Style="{DynamicResource ShowSerialsButtonStyle}"
                                        Visibility="{Binding HasSerials, Converter={x:Static controls:BoolToVisibilityConverter.Instance}}"
                                        Command="{Binding DataContext.OpenAllSerialsCommand, RelativeSource={RelativeSource AncestorType=Controls3:DataGrid}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock>
                                        <Run Text="Открыть все ("/>
                                        <Run Text="{Binding Count, StringFormat={}{0:0}, TargetNullValue=0}"/>
                                        <Run Text=") →"/>
                                    </TextBlock>
                                </Button>
                            </DockPanel>

                            <TextBlock Grid.Row="1"
                                       Text="Загрузка серийных номеров..."
                                       FontStyle="Italic"
                                       FontSize="11"
                                       Foreground="#64748B"
                                       Visibility="{Binding IsLoadingSerials, Converter={x:Static controls:BoolToVisibilityConverter.Instance}}"/>

                            <TextBlock Grid.Row="1"
                                       Text="{Binding SerialsError}"
                                       FontSize="11"
                                       Foreground="#DC2626"
                                       Visibility="{Binding HasSerialsError, Converter={x:Static controls:BoolToVisibilityConverter.Instance}}"/>

                            <TextBlock Grid.Row="1"
                                       Text="Серийные номера отсутствуют"
                                       FontSize="11"
                                       Foreground="#64748B"
                                       Visibility="{Binding HasSerials, Converter={x:Static controls:BoolToVisibilityConverter.Instance}, ConverterParameter=2}"/>

                            <Grid Grid.Row="1"
                                  Visibility="{Binding HasSerials, Converter={x:Static controls:BoolToVisibilityConverter.Instance}}">
                                <Grid Visibility="{Binding HasSerialsError, Converter={x:Static controls:BoolToVisibilityConverter.Instance}, ConverterParameter=2}">
                                    <DataGrid ItemsSource="{Binding SerialDevices}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserResizeRows="False"
                                              HeadersVisibility="Column"
                                              SelectionMode="Single"
                                              GridLinesVisibility="All"
                                              MaxHeight="180"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              PreviewMouseWheel="DetailsDataGrid_PreviewMouseWheel"
                                              Visibility="{Binding IsLoadingSerials, Converter={x:Static controls:BoolToVisibilityConverter.Instance}, ConverterParameter=2}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Binding="{Binding SerialNumber}"
                                                                MinWidth="160"
                                                                Width="Auto"
                                                                Header="{loc:Tr StoreDevice_SerialNumber, Fallback='Серийный №'}"/>
                                            <DataGridTextColumn Binding="{Binding MacAddress}"
                                                                MinWidth="150"
                                                                Width="Auto"
                                                                Header="{loc:Tr StoreDevice_MacAddress, Fallback='MAC-адрес'}"/>
                                            <DataGridTextColumn Binding="{Binding PonSerial}"
                                                                MinWidth="160"
                                                                Width="Auto"
                                                                Header="{loc:Tr StoreDevice_PonSerial, Fallback='PON-серийник'}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </Controls3:DataGrid.RowDetailsTemplate>
        </Controls3:DataGrid>
        <!--<b:Interaction.Triggers>
            <b:EventTrigger EventName="AutoGeneratingColumn">
                <input:EventToCommand PassEventArgsToCommand="True"
                                       Command="{Binding Path=AutoGenerateColumnCommand}"/>
            </b:EventTrigger>
            </b:Interaction.Triggers>-->
