                        <Controls3:ComboBox    
                                               SelectedItem="{Binding Path=Filter.StoreCustomerSegments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                               Width="100"
                                               ItemsSource="{Binding Source={StaticResource StoreCustomerSegmentsViewModel}, Path=ItemsView}"/>
                    </StackPanel>

