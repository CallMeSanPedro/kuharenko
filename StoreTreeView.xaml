<controls:UserView x:Class="Store.Views.Tree.StoreTreeView"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:controls="clr-namespace:DatumNode.Controls;assembly=DatumNode.Controls"
                    xmlns:tree="clr-namespace:Store.Tree"
                    xmlns:input1="clr-namespace:System.Windows.Input;assembly=DatumNode.Controls"
                    xmlns:smartTag="clr-namespace:Infrastructure.ViewModels.SmartTag;assembly=Store.ViewModels"
                    xmlns:initUzel2="clr-namespace:Store.ViewModels.InitUzel;assembly=Store.ViewModels"
                    xmlns:smartTag1="clr-namespace:Store.ViewModels.SmartTag;assembly=Store.ViewModels"
                    xmlns:converters1="clr-namespace:Infrastructure.Common.Converters"
                    xmlns:viewControls="clr-namespace:Store.Views.Controls;assembly=Store.Views"
                    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:icon="clr-namespace:Store.Views.Icons"
                    xmlns:loc="clr-namespace:Store.Views.Localization"
                    xmlns:local="clr-namespace:Store.Views.Tree"
                    mc:Ignorable="d" MinWidth="0">
    <controls:UserView.Resources>
        <controls:DataContextProxy x:Key="DataContextProxy"/>
        <smartTag1:SmartTagsViewModel x:Key="SmartTagsViewModel" TypObjM="15"/>
        <converters1:TypeStoreToImageConverter x:Key="TypeStoreToImageConverter"/>
        <controls:DataContextProxy x:Key="UzelsViewModel">
            <controls:DataContextProxy.ViewModel>
                <initUzel2:UzelsViewModel/>
            </controls:DataContextProxy.ViewModel>
        </controls:DataContextProxy>

        <!-- Sidebar Collapse / Expand / Warehouse Geometries -->
        <Geometry x:Key="SidebarIconCollapse">M15.41 16.59L10.83 12l4.58-4.59L14 6l-6 6 6 6 1.41-1.41z</Geometry>
        <Geometry x:Key="SidebarIconExpand">M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z</Geometry>
        <Geometry x:Key="SidebarIconWarehouse">M20 2H4C2.9 2 2 2.9 2 4V20C2 21.1 2.9 22 4 22H20C21.1 22 22 21.1 22 20V4C22 2.9 21.1 2 20 2M20 20H4V7H20V20M20 5H4V4H20V5M6 9H10V11H6V9M12 9H18V11H12V9M6 13H10V15H6V13M12 13H18V15H12V13M6 17H10V19H6V17M12 17H18V19H12V17Z</Geometry>

        <!-- Slim Modern ScrollBar Styles -->
        <Style x:Key="ModernScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                                Background="#B8C4D4"
                                CornerRadius="3"
                                Margin="1,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#8294B0"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#5B6F8C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernScrollBarThumbHorizontal" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                                Background="#B8C4D4"
                                CornerRadius="3"
                                Margin="0,1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#8294B0"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#5B6F8C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernScrollBarRepeatButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernSidebarScrollBar" TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="7"/>
                    <Setter Property="MinWidth" Value="7"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True" HorizontalAlignment="Center">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ModernScrollBarRepeatButton}"
                                                          Command="ScrollBar.PageUpCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ModernScrollBarThumb}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ModernScrollBarRepeatButton}"
                                                          Command="ScrollBar.PageDownCommand"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="7"/>
                    <Setter Property="MinHeight" Value="7"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False" VerticalAlignment="Center">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ModernScrollBarRepeatButton}"
                                                          Command="ScrollBar.PageLeftCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ModernScrollBarThumbHorizontal}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ModernScrollBarRepeatButton}"
                                                          Command="ScrollBar.PageRightCommand"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Sidebar TreeViewItem Style -->
        <Style x:Key="SidebarTreeViewItemStyle" TargetType="{x:Type TreeViewItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TreeViewItem}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Item Header Border -->
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="4"
                                    Margin="1,1"
                                    Padding="2,0"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Expander ToggleButton -->
                                    <ToggleButton x:Name="Expander"
                                                  Width="14" Height="14"
                                                  Focusable="False"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center">
                                        <ToggleButton.Style>
                                            <Style TargetType="{x:Type ToggleButton}">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                            <Border Background="Transparent" Width="14" Height="14">
                                                                <Path x:Name="Arrow"
                                                                      Data="M 4 2 L 8 6 L 4 10 Z"
                                                                      Fill="{DynamicResource Sidebar.ItemIdleFg}"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      RenderTransformOrigin="0.5,0.5">
                                                                    <Path.RenderTransform>
                                                                        <RotateTransform Angle="0"/>
                                                                    </Path.RenderTransform>
                                                                </Path>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="Arrow" Property="RenderTransform">
                                                                        <Setter.Value>
                                                                            <RotateTransform Angle="90"/>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource Sidebar.ItemSelectedFg}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource Sidebar.ItemHoverFg}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>

                                    <!-- Header Content -->
                                    <ContentPresenter x:Name="PART_Header"
                                                      Grid.Column="1"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Children Items -->
                            <ItemsPresenter x:Name="ItemsHost"
                                            Grid.Row="1"
                                            Margin="14,0,0,0"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- Collapse children when item is not expanded -->
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sidebar.ItemHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sidebar.ItemSelectedBg}"/>
                            </Trigger>

                            <!-- Collapsed mode: zero indent, hide expander, center icons -->
                            <DataTrigger Binding="{Binding Path=IsCollapsed, RelativeSource={RelativeSource AncestorType={x:Type local:StoreTreeView}}}" Value="True">
                                <Setter TargetName="Expander" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="ItemsHost" Property="Margin" Value="0"/>
                                <Setter TargetName="PART_Header" Property="HorizontalAlignment" Value="Center"/>
                                <Setter TargetName="Bd" Property="Margin" Value="0,1"/>
                                <Setter TargetName="Bd" Property="Padding" Value="0"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <controls:DialogDirector x:Key="SelectUzels" TargetViewModel="{Binding}" 
                                      ViewModel="{Binding Source={StaticResource UzelsViewModel}, Path=ViewModel}" 
                                      Refresh="True" 
                                      OpenCommand="{Binding Source={StaticResource UzelsViewModel}, Path=ViewModel.RefreshCommand}"
                                      Operation="Select" 
                                      OKButtonContent="{loc:Tr Dialog_Select, Fallback='Выбрать'}" CancelButtonContent="{loc:Tr Dialog_Close, Fallback='Закрыть'}" Title="{loc:Tr Ui_SelectNode, Fallback='Выбрать узел'}"
                                      TargetViewModelIsMaster="True">
            <controls:DialogDirector.Properties>
                <controls:PropertyBinding SourceProperty="{Binding Source={StaticResource UzelsViewModel},  Path=ViewModel.CurrentContainer.Item}"
                                              TargetProperty="{Binding Source={StaticResource DataContextProxy}, Path=DataSource.GisUzel, Mode=TwoWay}"
                                              />
            </controls:DialogDirector.Properties>
        </controls:DialogDirector>

    </controls:UserView.Resources>


    <Grid x:Name="LayoutRoot" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource Sidebar.Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Section Header -->
            <RowDefinition Height="Auto"/> <!-- Row 1: Search & Filter (smbx) -->
            <RowDefinition Height="*"/>    <!-- Row 2: TreeView -->
            <RowDefinition Height="Auto"/> <!-- Row 3: Bottom Collapse Button -->
        </Grid.RowDefinitions>

        <!-- Top Section Header -->
        <Border x:Name="SidebarHeader" Grid.Row="0"
                Background="{DynamicResource Sidebar.Bg}"
                BorderBrush="{DynamicResource Sidebar.Border}"
                BorderThickness="0,0,0,1"
                Height="36" Padding="8,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Warehouse Icon in Header -->
                <Viewbox x:Name="HeaderWarehouseIcon" Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Path Data="{StaticResource SidebarIconWarehouse}"
                          Fill="{DynamicResource Accent}" Stretch="Uniform"/>
                </Viewbox>

                <!-- Section Title (hidden when collapsed) -->
                <TextBlock x:Name="HeaderTitleText" Grid.Column="1"
                           Text="{loc:Tr Title_Derevo, Fallback='СКЛАДЫ'}"
                           FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource Sidebar.SectionHeaderFg}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <TextBox Grid.Row="1" Margin="3" Text="{Binding Path=Filter.FindStoreText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="StoreTextChange" Visibility="Collapsed"/>
        <Grid Grid.Row="1" Name="smbx" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBox Margin="3"  x:Name="GisUzel" Grid.Row="0" Grid.Column="0" Visibility="{Binding Path=SelectUzel}"
						   Text="{Binding Path=GisUzel.UzelName, UpdateSourceTrigger=PropertyChanged}"
                           HorizontalAlignment="Stretch"
                           IsReadOnly="True"
                           mah:TextBoxHelper.TextButton="True"
                           mah:TextBoxHelper.ClearTextButton="False"
                           mah:TextBoxHelper.ButtonCommand="{Binding Source={StaticResource DataContextProxy}, Path=DataSource.DialogCommand}"
                           mah:TextBoxHelper.ButtonCommandParameter="{StaticResource SelectUzels}"
                           Style="{StaticResource TextBoxSearchStyle}"
                           />
            <controls:TagsTextBox  Grid.Column="0" Grid.Row="1" Margin="3" HorizontalAlignment="Stretch" mah:TextBoxHelper.Watermark="{loc:Tr Ui_SearchWarehouse, Fallback='Поиск склада'}"
										   ItemsSource="{Binding Source={StaticResource SmartTagsViewModel}, Path=AutoItems, Mode=OneWay}" 
										   Text="{Binding Source={StaticResource SmartTagsViewModel}, Path=Filter.ObjStr, Mode=TwoWay}"
										   SelectedItems="{Binding Source={StaticResource SmartTagsViewModel}, Path=SmartSelectedItems}" 
										   SelectCommand="{Binding Source={StaticResource DataContextProxy}, Path=DataSource.SelCommandSm}"
										   TransformInitCommand="{Binding Source={StaticResource SmartTagsViewModel}, Path=TransformInitCommand}"
										   SelectedItemBinding="{Binding Path=Filter.SmartTag, Mode=TwoWay, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
									   >
                <controls:TagsTextBox.PopupListItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Path=ObjTypName}"/>
                            <TextBlock Margin="5,0,0,0" Text="{Binding Path=ObjName}" Foreground="Brown"/>
                        </StackPanel>
                    </DataTemplate>
                </controls:TagsTextBox.PopupListItemTemplate>
            </controls:TagsTextBox>
            <Button  
                ContentTemplate="{StaticResource IconEraserTemplate}" 
                Style="{StaticResource ToolbarButtonEditStyle}"
                Grid.Row="1"  Grid.Column="1" Name="btClearFilter"   Background="Transparent"
                ToolTipService.ToolTip="{loc:Tr Ui_ResetFilter, Fallback='Сбросить фильтр'}" 
                Command="{Binding Path=ClearFilterCommand}" 
				HorizontalAlignment="Right"
                    >
            </Button>
            <controls:Label Grid.Row="2" Grid.Column="0" Margin="3" Content="{loc:Tr Ui_ShowArchivedWarehouses, Fallback='Показывать архивные склады'}" HorizontalAlignment="Left" />
            <CheckBox Grid.Row="2" Grid.Column="1" Margin="2" HorizontalAlignment="Right"  VerticalAlignment="Center" x:Name="ShowArchiveStores" Command="{Binding Path=ShowArchiveCommand}" 
                          IsChecked="{Binding Source={StaticResource SmartTagsViewModel}, Path=Filter.ShowArchiveStores, Mode=TwoWay, ValidatesOnExceptions=True, NotifyOnValidationError=True}" 
                          Checked="ShowHiddenStore_Checked" Unchecked="ShowHiddenStore_Unchecked"/>
        </Grid>

        <!-- Tree View Container -->
        <Border x:Name="TreeBorder" Grid.Row="2" Margin="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                Background="Transparent" BorderThickness="0">
            <ScrollViewer x:Name="TreeScrollViewer" VerticalAlignment="Stretch"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          VerticalContentAlignment="Stretch">
                <ScrollViewer.Resources>
                    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernSidebarScrollBar}"/>
                </ScrollViewer.Resources>
                <controls:TreeView  x:Name="TreeView" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                          MouseLeftButtonUp="UIElement_OnMouseLeftButtonUp"
                          PreviewMouseWheel="TreeView_PreviewMouseWheel"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ItemsSource="{Binding Path=Root.ChildrenView}"
                          SelectedItemBinding="{Binding Path=CurrentItem, Mode=TwoWay}"
                          BorderThickness="0"
                          Background="Transparent"
                          ItemContainerStyle="{StaticResource SidebarTreeViewItemStyle}">
                    <ContextMenuService.ContextMenu >
                        <ContextMenu ItemsSource="{Binding Path=CurrentContainer, Converter={x:Static tree:StoreTreeObjToMenuConverter.Instance}}"/>
                    </ContextMenuService.ContextMenu>
                    <controls:TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Path=ChildrenView}">
                            <Border x:Name="ItemRowBorder" Background="Transparent" CornerRadius="4" Margin="0,1" Padding="2,2"
                                    ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="12000">
                                <Border.ToolTip>
                                    <ToolTip Background="{DynamicResource Sidebar.Bg}" BorderBrush="{DynamicResource Sidebar.Border}" BorderThickness="1">
                                        <StackPanel Margin="4,2" MaxWidth="280">
                                            <TextBlock Text="{Binding Path=Item.InfouzelSname}" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{DynamicResource Sidebar.ItemHoverFg}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Path=Item.Dopinfo2}" FontSize="11" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource Sidebar.SectionHeaderFg}" TextWrapping="Wrap"
                                                       Visibility="{Binding Path=Item.Dopinfo2, Converter={x:Static controls:NullToVisibilityConverter.Instance}}"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Border.ToolTip>
                                <Grid Height="28" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Warehouse Icon & Pin -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="📌" Foreground="Orange" FontWeight="Bold" Margin="0,0,2,0" FontSize="11" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Path=Item.IsPinned}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Image Height="18" Width="18" SnapsToDevicePixels="True" VerticalAlignment="Center"
                                               icon:TreeIcon.Type="{Binding Path=Item.Dopinfo}"/>
                                    </StackPanel>

                                    <!-- Warehouse Name (Hidden when tree is collapsed) -->
                                    <TextBlock x:Name="ItemNameLabel" Grid.Column="1"
                                               Text="{Binding Path=Item.InfouzelSname}"
                                               Foreground="{Binding Path=Item.UzelColor, FallbackValue={DynamicResource Sidebar.ItemIdleFg}}"
                                               Margin="6,0,4,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Visibility>
                                            <Binding Path="IsCollapsed" RelativeSource="{RelativeSource AncestorType={x:Type local:StoreTreeView}}">
                                                <Binding.Converter>
                                                    <controls:BooleanToVisibilityConverter/>
                                                </Binding.Converter>
                                                <Binding.ConverterParameter>invert</Binding.ConverterParameter>
                                            </Binding>
                                        </TextBlock.Visibility>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </HierarchicalDataTemplate>
                    </controls:TreeView.ItemTemplate>
                </controls:TreeView>
            </ScrollViewer>
        </Border>

        <!-- Bottom Collapse/Expand Button (matching SidebarNav) -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource Sidebar.Border}" BorderThickness="0,1,0,0" Padding="6,6">
            <Border x:Name="CollapseButton" CornerRadius="6" Height="36" Cursor="Hand" Background="Transparent" Margin="0,1"
                    MouseLeftButtonUp="CollapseButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Viewbox Grid.Column="0" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path x:Name="CollapseIcon" Data="{StaticResource SidebarIconCollapse}"
                              Fill="{DynamicResource Sidebar.ItemIdleFg}" Stretch="Uniform"/>
                    </Viewbox>

                    <TextBlock x:Name="CollapseLabel" Grid.Column="1"
                               Text="{loc:Tr Sidebar_Collapse, Fallback='Свернуть'}"
                               FontSize="12" Foreground="{DynamicResource Sidebar.ItemIdleFg}"
                               VerticalAlignment="Center" Margin="4,0,6,0"/>
                </Grid>
                <Border.ToolTip>
                    <ToolTip x:Name="CollapseToolTip" Content="{loc:Tr Sidebar_Collapse, Fallback='Свернуть дерево'}"/>
                </Border.ToolTip>
            </Border>
        </Border>
    </Grid>

</controls:UserView>
