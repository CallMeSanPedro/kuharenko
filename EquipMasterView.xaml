								   }" 
					  windows:BindingHelper.UpdateSourceOnChange="True" 
					  Views:ComboBox.Mode="AsyncEager">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel   Orientation="Horizontal" ToolTipService.ToolTip="{Binding Path=Name}">
