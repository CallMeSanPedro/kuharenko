                            </Button>
                        </WrapPanel>-->
                        <Border Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="0">
						</Border>

						<!--<Line Stroke="Black" Grid.Row="1" Grid.ColumnSpan="2" StrokeDashArray="4 1 2 1" StrokeThickness="1" ></Line>-->
					</Grid>
                    <!--<ScrollViewer Grid.Row="1" BorderThickness="0" Padding="0" Margin="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">-->
                    <controls:DataContentPresenter  Grid.Row="1" Margin="1"  Content="{Binding Path=DetailViewModel}"/>
                    <!--</ScrollViewer>-->
                    <!--<ContentControl  Visibility="{Binding ElementName=LB, Path=Items, Converter={StaticResource BoolToVisibilityConverter}}"  >-->
					<!--Visibility="{Binding Path=MasterViewModel.Filter.ShowLink, Converter={StaticResource BoolToVisibilityConverter}}"-->

					<!--</ContentControl>-->
				</Grid>
			</Border>


            <!--<Views:DataContentPresenter Grid.Column="2" Margin="3" Content="{Binding Path=DetailViewModel}"/>-->
        </Grid>
        <Border  Grid.Row="1"  Margin="3,0,3,3" Padding="0"			
				>

