                                            <Image Source="/Ltu;component/Images/Delete_16x16.png"/>
                                        </controls:CustomMenuItem.Icon>
                                    </controls:CustomMenuItem>
                                    <controls:CustomMenuItem Header="Удалить другие" Command="{Binding Source={StaticResource EthLinkHistViewModel}, 
                                                    Path=ViewModel.DelAllBLinkCommand}" CommandParameter="{Binding}">
