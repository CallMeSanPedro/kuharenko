                                        <controls:CustomMenuItem.Icon>
                                            <Image Source="/Ltu;component/Images/Select.png"/>
                                        </controls:CustomMenuItem.Icon>
                                    </controls:CustomMenuItem>
                                    <controls:CustomMenuItem Header="Найти в дереве" Command="{Binding Source={StaticResource EthLinkHistViewModel}, 
                                                    Path=ViewModel.FindLinkCommand}" CommandParameter="{Binding}" Visibility="Collapsed">
                                        <controls:CustomMenuItem.Icon>
                                            <Image Source="/Ltu;component/Images/Find_16x16.png"/>
                                        </controls:CustomMenuItem.Icon>
