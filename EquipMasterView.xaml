	<Grid Background="White">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"></RowDefinition>
			<RowDefinition Height="auto"></RowDefinition>
		</Grid.RowDefinitions>

		<Grid  x:Name="LayoutRoot" Background="Transparent" Grid.Row="0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition x:Name="MasterCol" Width="260">
					<ColumnDefinition.Style>
						<Style TargetType="ColumnDefinition">
							<Style.Triggers>
								<DataTrigger Binding="{Binding ElementName=Master, Path=Visibility}" Value="Collapsed">
									<Setter Property="Width" Value="0"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</ColumnDefinition.Style>
				</ColumnDefinition>
				<ColumnDefinition x:Name="SplitterCol" Width="Auto">
					<ColumnDefinition.Style>
						<Style TargetType="ColumnDefinition">
							<Style.Triggers>
								<DataTrigger Binding="{Binding ElementName=Master, Path=Visibility}" Value="Collapsed">
									<Setter Property="Width" Value="0"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</ColumnDefinition.Style>
				</ColumnDefinition>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

            <Border x:Name="Master" Grid.Column="0" Grid.Row="0"
                    Background="{DynamicResource Sidebar.Bg}"
                    BorderBrush="{DynamicResource Sidebar.Border}"
                    BorderThickness="0,0,1,0"
                    Padding="0" Margin="0">
				<controls:DataContentPresenter   Content="{Binding Path=MasterViewModel}" VerticalAlignment="Stretch"/>
			</Border>

            <GridSplitter Grid.Column="1" x:Name="GridSplitter" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{DynamicResource Sidebar.Border}" Margin="0" ShowsPreview="True" Width="4"
                          Cursor="SizeWE"
                          Visibility="{Binding ElementName=Master, Path=Visibility}"/>
            <!--</Expander>-->
			<!--<TextBlock Grid.Column="1" Grid.Row="0" Width="5" Visibility="{Binding Path=Visibility, ElementName=GridSplitter, Converter={StaticResource InvertVisibilityConverter}}"></TextBlock>-->


            <Border Style="{DynamicResource MainContentBorders}"  Grid.Column="2" Grid.Row="0" Margin="0,3,3,3">
            <Grid  Visibility="{Binding Path=MasterViewModel.HasDetail, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
					<Grid.RowDefinitions>
						<RowDefinition Height="auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="auto"/>
					</Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/> 
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Row="0" Visibility="{Binding Path=Visibility, Source={x:Reference CheckBox}}">
						<Grid.RowDefinitions>
							<RowDefinition></RowDefinition>
							<RowDefinition></RowDefinition>
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition />
						</Grid.ColumnDefinitions>
                        <!--<CheckBox Grid.Row="0" Grid.Column="0"  CommandTarget="{Binding ElementName=Master}" 
                                  x:Name="CheckBox" Content="{Binding Path=MasterViewModel.CurrentText}" 
                                  IsChecked="True" Visibility="{Binding Path=MasterViewModel.HasDetail, 
                            Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}"/>-->
                        <controls:NavigationButton Grid.Row="0" x:Name="CheckBox" IsChecked="True" Margin="3"
                                                   Visibility="{Binding Path=MasterViewModel.HasDetail, Converter={x:Static controls:NullToVisibilityConverter.Instance}}"
                                                   HorizontalAlignment="Left"
                                                   HorizontalContentAlignment="Left"
                                                   FontWeight="SemiBold"
                                                   Target="{Binding ElementName=Master}"
                                                   Content="{Binding IsChecked, RelativeSource={RelativeSource Self}}">
                            <controls:NavigationButton.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <!-- Развернуто: свернуть -->
                                                <Setter Property="Text" Value="◀"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="False">
                                                        <!-- Свернуто: развернуть -->
                                                        <Setter Property="Text" Value="▶"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </controls:NavigationButton.ContentTemplate>
                        </controls:NavigationButton>

                        <!--<TextBlock Text=""></TextBlock>-->
                        <!--<WrapPanel  Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                            <Button Margin="0"   x:Name="AddToTabs" Command="{Binding Path=MasterViewModel.AddLinkCommand}" ToolTipService.ToolTip="Добавить в закладки" Visibility="Visible">
                                <Image Margin="0" HorizontalAlignment="Right" Source="/Store.Views;component/Images/AddToTabs.png" Width="16" Height="16" />                                                                
                            </Button>
                            <Button Margin="0"  x:Name="RefreshContent" Command="{Binding Path=DetailViewModel.RefreshCommand}" ToolTipService.ToolTip="Обновить содержимое">
