<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime"
                    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:controls="clr-namespace:DatumNode.Controls;assembly=DatumNode.Controls"
                    xmlns:loc="clr-namespace:Store.Views.Localization">
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.Modern.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <system:String x:Key="Store.CurrentTheme">ModernSidebar</system:String>
    <system:Boolean x:Key="Store.IsSidebarLayout">True</system:Boolean>
    <Visibility x:Key="SidebarVisibility">Visible</Visibility>
    <Visibility x:Key="TopTabsVisibility">Collapsed</Visibility>
    <Visibility x:Key="SidebarModeHeaderVisibility">Collapsed</Visibility>
    <Visibility x:Key="ModernStatusBarVisibility">Visible</Visibility>
    <Visibility x:Key="TopStatusVisibility">Collapsed</Visibility>
    <Visibility x:Key="TopHeaderVisibility">Collapsed</Visibility>

    <!-- Корпоративный акцент из шапки Default (#0F2D5B / #1B3F6F / #E8F1FB) -->
    <SolidColorBrush x:Key="Accent" Color="#1B3F6F"/>
    <SolidColorBrush x:Key="AccentHover" Color="#0F2D5B"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#E8F1FB"/>
    <SolidColorBrush x:Key="BrandBadgeBg" Color="#0F2D5B"/>

    <!-- Сайдбар: контрастный каркас light slate #F1F5F9 с четкой рамкой #CBD5E1 -->
    <SolidColorBrush x:Key="Sidebar.Bg" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="Sidebar.Border" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="Sidebar.SectionHeaderFg" Color="#64748B"/>
    <SolidColorBrush x:Key="Sidebar.ItemIdleFg" Color="#334155"/>
    <SolidColorBrush x:Key="Sidebar.ItemHoverBg" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Sidebar.ItemHoverFg" Color="#0F172A"/>
    <SolidColorBrush x:Key="Sidebar.ItemSelectedBg" Color="#E8F1FB"/>
    <SolidColorBrush x:Key="Sidebar.ItemSelectedFg" Color="#1B3F6F"/>
    <SolidColorBrush x:Key="Sidebar.AccentIndicator" Color="#1B3F6F"/>

    <!-- Нижняя строка состояния -->
    <SolidColorBrush x:Key="StatusBar.Bg" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="StatusBar.Border" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="StatusBar.Fg" Color="#64748B"/>
    <SolidColorBrush x:Key="StatusBar.BadgeBg" Color="#FFFFFF"/>
</ResourceDictionary>
