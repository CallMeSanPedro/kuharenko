<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime"
                    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:controls="clr-namespace:DatumNode.Controls;assembly=DatumNode.Controls"
                    xmlns:loc="clr-namespace:Store.Views.Localization">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source ="../Icons/TreeIcons.Modern.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    
    <system:String x:Key="Store.CurrentTheme">Modern</system:String>
    <system:Boolean x:Key="Store.IsSidebarLayout">False</system:Boolean>
    <Visibility x:Key="SidebarVisibility">Collapsed</Visibility>
    <Visibility x:Key="TopTabsVisibility">Visible</Visibility>
    <Visibility x:Key="SidebarModeHeaderVisibility">Collapsed</Visibility>
    <Visibility x:Key="ModernStatusBarVisibility">Visible</Visibility>
    <Visibility x:Key="TopStatusVisibility">Collapsed</Visibility>
    <Visibility x:Key="TopHeaderVisibility">Visible</Visibility>

    <!-- Корпоративный логотип-бейдж из Default (#0F2D5B) -->
    <SolidColorBrush x:Key="BrandBadgeBg" Color="#0F2D5B"/>

    <!-- 1. Цветовая палитра: Fluent Corporate -->
    <!-- Общий фон окна: мягкий нейтральный серо-голубой #EEF2F6 (убирает слепящую белизну) -->
    <SolidColorBrush x:Key="PageBg" Color="#EEF2F6"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#CBD5E1"/>

    <!-- Верхняя панель (шапка) -->
    <SolidColorBrush x:Key="HeaderBarBg" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="HeaderBarBorder" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="HeaderBarText" Color="#0F172A"/>
    <SolidColorBrush x:Key="HeaderBarMuted" Color="#64748B"/>
    <SolidColorBrush x:Key="HeaderChipBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderChipBorder" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="HeaderChipHoverBg" Color="#E8F1FB"/>
    <SolidColorBrush x:Key="HeaderChipHoverBorder" Color="#1B3F6F"/>

    <!-- Сайдбар: контрастный каркас light slate #F1F5F9 с четкой рамкой #CBD5E1 -->
    <SolidColorBrush x:Key="Sidebar.Bg" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="Sidebar.Border" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="Sidebar.SectionHeaderFg" Color="#64748B"/>
    <SolidColorBrush x:Key="Sidebar.ItemIdleFg" Color="#334155"/>
    <SolidColorBrush x:Key="Sidebar.ItemHoverBg" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Sidebar.ItemHoverFg" Color="#0F172A"/>
    <SolidColorBrush x:Key="Sidebar.ItemSelectedBg" Color="#E8F1FB"/>
    <SolidColorBrush x:Key="Sidebar.ItemSelectedFg" Color="#1B3F6F"/>
    <SolidColorBrush x:Key="Sidebar.AccentIndicator" Color="#1B3F6F"/>

    <!-- Нижняя строка состояния -->
    <SolidColorBrush x:Key="StatusBar.Bg" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="StatusBar.Border" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="StatusBar.Fg" Color="#64748B"/>
    <SolidColorBrush x:Key="StatusBar.BadgeBg" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>

    <!-- Первичные действия: сдержанный корпоративный синий #1B3F6F (Default) -->
    <SolidColorBrush x:Key="Accent" Color="#1B3F6F"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#E8F1FB"/>
    <SolidColorBrush x:Key="AccentHover" Color="#0F2D5B"/>
    <SolidColorBrush x:Key="InputBorder" Color="#CBD5E1"/>

    <!-- Вкладки (Tabs) -->
    <SolidColorBrush x:Key="Tab.IdleForeground" Color="#64748B"/>
    <SolidColorBrush x:Key="Tab.HoverForeground" Color="#0F172A"/>
    <SolidColorBrush x:Key="Tab.HoverBackground" Color="#E8F1FB"/>
    <SolidColorBrush x:Key="Tab.SelectedForeground" Color="#1B3F6F"/>
    <SolidColorBrush x:Key="Tab.SelectedBackground" Color="#E8F1FB"/>
    <SolidColorBrush x:Key="Tab.SelectedUnderline" Color="#1B3F6F"/>

    <!-- Таблицы: контрастные заголовки #E2E8F0, выделение #DBEAFE, четкие разделители #CBD5E1 -->
    <SolidColorBrush x:Key="DataGrid.HeaderBg" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="DataGrid.SelectedRowBg" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="DataGrid.HoverRowBg" Color="#EDF4FC"/>
    <SolidColorBrush x:Key="DataGrid.Line" Color="#CBD5E1"/>

    <!-- Бейджи статусов: пастельные плашки с полужирным текстом -->
    <SolidColorBrush x:Key="Badge.SuccessBg" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="Badge.SuccessFg" Color="#15803D"/>
    <SolidColorBrush x:Key="Badge.WarningBg" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="Badge.WarningFg" Color="#B45309"/>
    <SolidColorBrush x:Key="Badge.NeutralBg" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Badge.NeutralFg" Color="#334155"/>
    <SolidColorBrush x:Key="Badge.InfoBg" Color="#E8F1FB"/>
    <SolidColorBrush x:Key="Badge.InfoFg" Color="#1B3F6F"/>

    <!-- Фильтрация: корпоративный акцент #1B3F6F -->
    <SolidColorBrush x:Key="HeaderFilter.Accent" Color="#1B3F6F"/>
    <SolidColorBrush x:Key="HeaderFilter.AccentHoverBg" Color="#E8F1FB"/>
    <SolidColorBrush x:Key="HeaderFilter.ChipBg" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="HeaderFilter.ChipBorder" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="HeaderFilter.ChipTitle" Color="#64748B"/>
    <SolidColorBrush x:Key="HeaderFilter.ChipValue" Color="#0F172A"/>
    <SolidColorBrush x:Key="ColumnFilter.PopupBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ColumnFilter.PopupBorder" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="ColumnFilter.Icon" Color="#64748B"/>
    <SolidColorBrush x:Key="ColumnFilter.IconActive" Color="#1B3F6F"/>

    <!-- Дерево навигации -->
    <SolidColorBrush x:Key="Tree.SelectedBg" Color="#E8F1FB"/>
    <SolidColorBrush x:Key="Tree.SelectedText" Color="#1B3F6F"/>

    <!-- Параметры компактных чипов-кнопок со скруглением 6px -->
    <CornerRadius x:Key="Control.CornerRadius">6</CornerRadius>
    <system:Double x:Key="Control.ButtonHeight">30</system:Double>

    <!-- 2. Форма карточек контента: строгое скругление 8px -->
    <Style x:Key="MainContentBorders" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- 3. Форма кнопок -->
    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <!-- 4. Таблица: контрастные заголовки #E2E8F0, выделение #DBEAFE, горизонтальные и вертикальные разделители #CBD5E1 -->
    <Style x:Key="ModernDataGridColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource DataGrid.HeaderBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DataGrid.Line}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <Thumb x:Name="PART_LeftHeaderGripper"
                               HorizontalAlignment="Left"
                               Width="8"
                               Background="Transparent"
                               Opacity="0"/>
                        <Thumb x:Name="PART_RightHeaderGripper"
                               HorizontalAlignment="Right"
                               Width="8"
                               Background="Transparent"
                               Opacity="0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernDataGridColumnHeader}"/>

    <Style x:Key="ModernDataGridCell" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell" BasedOn="{StaticResource ModernDataGridCell}"/>

    <!-- Строка таблицы: нижняя рамка 1px гарантирует горизонтальные разделители строк -->
    <Style x:Key="ModernDataGridRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DataGrid.Line}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DataGrid.HoverRowBg}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource DataGrid.SelectedRowBg}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True"/>
                    <Condition Property="Selector.IsSelectionActive" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource DataGrid.SelectedRowBg}"/>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRow}"/>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        <Setter Property="RowBackground" Value="White"/>
        <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DataGrid.Line}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource DataGrid.Line}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource ModernDataGridColumnHeader}"/>
        <Setter Property="CellStyle" Value="{StaticResource ModernDataGridCell}"/>
        <Setter Property="RowStyle" Value="{StaticResource ModernDataGridRow}"/>
        <Setter Property="loc:LocalizedColumnHeaders.IsEnabled" Value="True"/>
    </Style>

    <!-- 5. Кнопки переключения режимов (чипы сегментов) -->
    <Style x:Key="ModeButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource CardBg}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="14,3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HeaderFilter.AccentHoverBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModeButtonLeftStyle" TargetType="RadioButton" BasedOn="{StaticResource ModeButtonStyle}"/>
    <Style x:Key="ModeButtonRightStyle" TargetType="RadioButton" BasedOn="{StaticResource ModeButtonStyle}"/>

    <Style x:Key="ModeActionButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="Background" Value="{DynamicResource CardBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PageBg}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BackToBalanceButtonStyle" TargetType="Button" BasedOn="{StaticResource ModeActionButtonStyle}"/>
    <Style x:Key="ShowSerialsButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="10,2"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#0A2244"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#0A2244"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 6. Фильтры колонок таблиц -->
    <Style x:Key="ColumnFilter.Title" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="ColumnFilter.Button" TargetType="ToggleButton">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource ColumnFilter.Icon}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ColumnFilter.IconActive}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ColumnFilter.Popup" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ColumnFilter.PopupBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColumnFilter.PopupBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Width" Value="240"/>
        <Setter Property="MaxHeight" Value="320"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="ColumnFilter.Search" TargetType="TextBox">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColumnFilter.PopupBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource ColumnFilter.PopupBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <Style x:Key="ColumnFilter.SelectAll" TargetType="CheckBox">
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="ColumnFilter.Option" TargetType="CheckBox">
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <Style x:Key="ColumnFilter.Reset" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- 7. Бейджи статусов (пастельные плашки, полужирный текст, скругление 6px) -->
    <Style x:Key="StatusBadge" TargetType="Border">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource Badge.NeutralBg}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextElement.FontSize" Value="11"/>
        <Setter Property="TextElement.FontWeight" Value="Bold"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Badge.NeutralFg}"/>
        <Style.Triggers>
            <Trigger Property="Tag" Value="Success">
                <Setter Property="Background" Value="{DynamicResource Badge.SuccessBg}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Badge.SuccessFg}"/>
            </Trigger>
            <Trigger Property="Tag" Value="Neutral">
                <Setter Property="Background" Value="{DynamicResource Badge.NeutralBg}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Badge.NeutralFg}"/>
            </Trigger>
            <Trigger Property="Tag" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource Badge.WarningBg}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Badge.WarningFg}"/>
            </Trigger>
            <Trigger Property="Tag" Value="Info">
                <Setter Property="Background" Value="{DynamicResource Badge.InfoBg}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Badge.InfoFg}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 8. Вкладки (TabControl / TabItem): современный стиль Fluent / M365 с нижней полосой -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="mah:TabControlHelper.Underlined" Value="None"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ColumnDefinition0"/>
                            <ColumnDefinition x:Name="ColumnDefinition1" Width="0"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="RowDefinition0" Height="Auto"/>
                            <RowDefinition x:Name="RowDefinition1" Height="*"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="HeaderPanel"
                                Grid.Row="0"
                                Grid.Column="0"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="0,0,0,1"
                                Margin="0,0,0,4"
                                SnapsToDevicePixels="True">
                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabNavigation="Local"/>
                        </Border>
                        <Border x:Name="ContentPanel"
                                Grid.Row="1"
                                Grid.Column="0"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="TabStripPlacement" Value="Bottom">
                            <Setter TargetName="HeaderPanel" Property="Grid.Row" Value="1"/>
                            <Setter TargetName="HeaderPanel" Property="BorderThickness" Value="0,1,0,0"/>
                            <Setter TargetName="ContentPanel" Property="Grid.Row" Value="0"/>
                            <Setter TargetName="RowDefinition0" Property="Height" Value="*"/>
                            <Setter TargetName="RowDefinition1" Property="Height" Value="Auto"/>
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Left">
                            <Setter TargetName="ColumnDefinition0" Property="Width" Value="Auto"/>
                            <Setter TargetName="ColumnDefinition1" Property="Width" Value="*"/>
                            <Setter TargetName="HeaderPanel" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="HeaderPanel" Property="Grid.Row" Value="0"/>
                            <Setter TargetName="HeaderPanel" Property="BorderThickness" Value="0,0,1,0"/>
                            <Setter TargetName="ContentPanel" Property="Grid.Column" Value="1"/>
                            <Setter TargetName="ContentPanel" Property="Grid.Row" Value="0"/>
                            <Setter TargetName="RowDefinition0" Property="Height" Value="*"/>
                            <Setter TargetName="RowDefinition1" Property="Height" Value="0"/>
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Right">
                            <Setter TargetName="ColumnDefinition0" Property="Width" Value="*"/>
                            <Setter TargetName="ColumnDefinition1" Property="Width" Value="Auto"/>
                            <Setter TargetName="HeaderPanel" Property="Grid.Column" Value="1"/>
                            <Setter TargetName="HeaderPanel" Property="Grid.Row" Value="0"/>
                            <Setter TargetName="HeaderPanel" Property="BorderThickness" Value="1,0,0,0"/>
                            <Setter TargetName="ContentPanel" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="ContentPanel" Property="Grid.Row" Value="0"/>
                            <Setter TargetName="RowDefinition0" Property="Height" Value="*"/>
                            <Setter TargetName="RowDefinition1" Property="Height" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBorder" Background="Transparent" CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}">
                        <DockPanel LastChildFill="True">
                            <Rectangle x:Name="Underline"
                                       DockPanel.Dock="Bottom"
                                       Height="2.5"
                                       Margin="0,4,0,-1"
                                       RadiusX="1.25" RadiusY="1.25"
                                       Fill="Transparent"
                                       SnapsToDevicePixels="True"/>
                            <ContentPresenter x:Name="HeaderText"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{DynamicResource TextSecondary}"
                                              TextElement.FontSize="12"
                                              TextElement.FontWeight="Normal"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Tab.HoverBackground}"/>
                            <Setter TargetName="HeaderText" Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Tab.SelectedBackground}"/>
                            <Setter TargetName="Underline" Property="Fill" Value="{DynamicResource Tab.SelectedUnderline}"/>
                            <Setter TargetName="HeaderText" Property="TextElement.Foreground" Value="{DynamicResource Tab.SelectedForeground}"/>
                            <Setter TargetName="HeaderText" Property="TextElement.FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="HeaderText" Property="TextElement.Foreground" Value="#94A3B8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 9. Всплывающее меню настроек и ровный разделитель без отступов под иконки -->
    <Style x:Key="ModernContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="#FFFFFF"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="4"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.12" Color="#0F172A"/>
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernMenuSeparatorStyle" TargetType="Separator">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="4,4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Fill="{DynamicResource CardBorder}" Margin="6,3" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
