<!--
MainView.xaml, шапка. Вставить вместо корневого Grid.

Локальный Style HeaderMenuTabControl удалить: голый TabPanel перекрывает словарь.
Нужны ContentPageStyles.xaml (стили вкладок и «Ещё») и HeaderOverflowPanel.cs.

Пока пункты влезают в среднюю колонку, они на месте и по центру.
Не влезшие целиком переносятся в «Ещё» слева от гамбургера. Порядок сохраняется.
Гамбургер и «Ещё» стоят в правой док-панели и не уезжают за край окна.
-->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:DatumNode.Controls;assembly=DatumNode.Controls"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:input="clr-namespace:System.Windows.Input;assembly=DatumNode.Controls"
      xmlns:views="clr-namespace:Store.Views"
      Background="{StaticResource HeaderBarBg}"
      Height="52">
    <DockPanel LastChildFill="True">
        <StackPanel x:Name="HeaderTools"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
            <Menu x:Name="HeaderMore"
                  Style="{StaticResource HeaderOverflowMenu}"
                  Visibility="Collapsed">
                <MenuItem x:Name="HeaderMoreItem"
                          Header="Ещё"
                          Style="{StaticResource HeaderOverflowItem}"/>
            </Menu>
            <Menu Style="{StaticResource HeaderHamburgerMenu}">
                <MenuItem Style="{StaticResource HeaderHamburgerItem}">
                    <MenuItem Header="Выбор стиля"
                              Style="{StaticResource HeaderDropdownMenuItem}">
                        <MenuItem Header="По умолчанию (Default)"
                                  Tag="Default"
                                  Click="ThemeMenuItem_OnClick"
                                  Style="{StaticResource HeaderDropdownMenuItem}"/>
                        <MenuItem Header="Современный (Modern)"
                                  Tag="Modern"
                                  Click="ThemeMenuItem_OnClick"
                                  Style="{StaticResource HeaderDropdownMenuItem}"/>
                        <MenuItem Header="Контрастный (Contrast)"
                                  Tag="Contrast"
                                  Click="ThemeMenuItem_OnClick"
                                  Style="{StaticResource HeaderDropdownMenuItem}"/>
                        <MenuItem Header="Старый исходный (Legacy)"
                                  Tag="Legacy"
                                  Click="ThemeMenuItem_OnClick"
                                  Style="{StaticResource HeaderDropdownMenuItem}"/>
                    </MenuItem>
                </MenuItem>
            </Menu>
        </StackPanel>

        <Grid x:Name="StackPanel" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0">
                <TextBlock x:Name="AppLogotype" Style="{StaticResource AppLogotypeStyle}" Foreground="{StaticResource HeaderBarText}" VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding AppLogotype}" ToolTipService.ToolTip="{Binding Path=AppConfig.ProgramTitle}"/>
                <TextBlock x:Name="AppText" Text="{Binding CurrentVersion}" Style="{StaticResource LinksMainMenuStyle}" Foreground="{StaticResource HeaderBarMuted}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button x:Name="BtnUzel" VerticalAlignment="Center" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Style="{StaticResource MainMenuButton}" Command="{Binding Path=DialogCommand}" CommandParameter="{StaticResource Uzel}" Margin="0,0,12,0" Cursor="Hand">
                    <TextBlock Foreground="{StaticResource HeaderBarText}" FontSize="13" Text="{Binding Path=UzelsMasterViewModel.MasterViewModel.CurrentItem}" ToolTipService.ToolTip="{Binding Path=UzelsMasterViewModel.MasterViewModel.CurrentItem.RightInfo}"/>
                </Button>
                <ContentControl Background="Transparent" MouseRightButtonUp="ContentControl_MouseRightButtonUp" IsTabStop="False" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ButtonBlackStyle}" Padding="0" Foreground="{StaticResource HeaderBarMuted}" Opacity="0.9" VerticalAlignment="Center" IsTabStop="False" Background="Transparent" BorderThickness="0" Command="{Binding Path=CloseAllRequestsCommand}" Content="{Binding Path=StatusText, Mode=OneWay}" ToolTipService.ToolTip="{Binding Path=Requests}"/>
                        <controls:LoadingIndicator Padding="0" VerticalAlignment="Center" Foreground="{StaticResource HeaderBarText}" Visibility="{Binding Path=Status, Converter={x:Static controls:StatusToVisibilityConverter.Instance}}"/>
                    </StackPanel>
                </ContentControl>
            </StackPanel>

            <TabControl x:Name="LinksBorder"
                        Grid.Column="1"
                        Style="{StaticResource HeaderMenuTabControl}"
                        ItemContainerStyle="{StaticResource HeaderMenuTabItem}"
                        views:HeaderOverflowPanel.MoreMenu="{Binding ElementName=HeaderMoreItem}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        mah:TabControlHelper.Underlined="None">
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="SelectionChanged">
                        <input:EventToCommand x:Name="EventToCommand"
                                              Command="{Binding ElementName=View, Path=DataContext.DialogCommand}"
                                              CommandParameter="{Binding ElementName=LinksBorder, Path=SelectedItem.Tag}"/>
                    </b:EventTrigger>
                </b:Interaction.Triggers>
                <TabItem Header="Склад" Tag="{StaticResource EquipMasterViewModel}"/>
                <TabItem Header="Справочники" Tag="{StaticResource StoreReferenceListMasterDetailViewModel}"/>
                <TabItem Header="Отчёты" Tag="{StaticResource StoreReportsListViewModel}"/>
                <TabItem Header="Интеграция" Tag="{StaticResource OebsCommandsViewModel}" Visibility="{Binding Path=CanMenuOebs, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}"/>
                <TabItem Header="Аудит" Tag="{StaticResource AuditViewModel}" Visibility="{Binding Path=CanMenuAudit, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}"/>
            </TabControl>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,8,0">
                <Button Style="{StaticResource ButtonAccentStyle}" Content="{StaticResource IconUser}" ContentTemplate="{StaticResource IconTemplate}" Background="Transparent" BorderThickness="0" IsEnabled="False"/>
                <TextBlock x:Name="UserLabel" VerticalAlignment="Center" Style="{StaticResource LinksMainMenuStyle}" Foreground="{StaticResource HeaderBarText}" Text="{Binding Path=User, TargetNullValue=Не авторизован}"/>
                <Button Style="{StaticResource ButtonAccentStyle}" Content="{StaticResource IconHelps}" ContentTemplate="{StaticResource IconTemplate}" Background="Transparent" BorderThickness="0" IsEnabled="False" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="label1" Style="{StaticResource LinksMainMenuStyle}">
                    <Hyperlink x:Name="HbInstrBtn" FontWeight="Normal" TextDecorations="None" TargetName="_blank" Foreground="{StaticResource HeaderBarText}" Click="Hyperlink1_OnClick">Помощь</Hyperlink>
                </TextBlock>
                <TextBlock x:Name="InfoLabel" FontSize="11" Opacity="0.8" Foreground="{StaticResource HeaderBarText}" Margin="10,0,0,0" Visibility="Hidden" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Path=LastRequests}" MouseLeftButtonUp="InfoLabel_MouseLeftButtonUp"/>
                <TextBlock x:Name="label2" Margin="16,0,0,0" Style="{StaticResource LinksMainMenuStyle}">
                    <Hyperlink Foreground="{StaticResource HeaderBarMuted}" FontWeight="Normal" TextDecorations="None" Click="Hyperlink_OnClick">© ООО &quot;Техноград плюс&quot;</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Grid>
    </DockPanel>
</Grid>
