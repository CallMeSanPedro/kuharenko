<!--
В шапке только значок. По нажатию открывается список или поле поиска.
xmlns:controls3 — тот же, что у MultiSelectComboBox.
xmlns:filtering="clr-namespace:Store.Views.Filtering"

StaysOpen остаётся True: иначе клик по выпадающему списку MultiSelectComboBox
закрывает сам фильтр. Скрытие по клику снаружи делает ColumnFilterPopup.
-->
<DataTemplate x:Key="ColumnFilterHeaderTemplate">
    <Grid MinHeight="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="{Binding Title}"
                   VerticalAlignment="Center"
                   Margin="0,0,6,0"/>

        <ToggleButton x:Name="FilterButton"
                      Grid.Column="1"
                      Width="16"
                      Height="16"
                      Padding="0"
                      BorderThickness="0"
                      Background="Transparent"
                      Cursor="Hand"
                      VerticalAlignment="Center"
                      ToolTip="Фильтр">
            <Path Data="M 0,0 L 10,0 L 6.2,4.6 L 6.2,9 L 3.8,9 L 3.8,4.6 Z"
                  Width="10"
                  Height="9"
                  Stretch="Uniform">
                <Path.Style>
                    <Style TargetType="Path">
                        <Setter Property="Fill" Value="#94A3B8"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Fill" Value="#1B3F6F"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Path.Style>
            </Path>
        </ToggleButton>

        <Popup PlacementTarget="{Binding ElementName=FilterButton}"
               Placement="Bottom"
               StaysOpen="True"
               AllowsTransparency="True"
               filtering:ColumnFilterPopup.ClosesOnOutsideClick="True"
               IsOpen="{Binding IsChecked, ElementName=FilterButton, Mode=TwoWay}">
            <Border Background="White"
                    BorderBrush="#D5DEE9"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8"
                    Margin="0,4,0,0">
                <StackPanel>
                    <controls3:MultiSelectComboBox MinWidth="180"
                        EmptyText="Все"
                        AddAllItem="True"
                        ItemsSource="{Binding Options}"
                        SelectedItems="{Binding SelectedItems, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding IsCheckList, Converter={x:Static controls3:BooleanToVisibilityConverter.Instance}}" />
                    <TextBox MinWidth="180"
                        Height="28"
                        Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding IsText, Converter={x:Static controls3:BooleanToVisibilityConverter.Instance}}" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</DataTemplate>

<!-- Сводка активных фильтров шапки. Строки нет, пока ни один фильтр не задан. -->
<Style x:Key="HeaderFilterChipStyle" TargetType="Border">
    <Setter Property="Background" Value="#FFF4F0F8"/>
    <Setter Property="BorderBrush" Value="#FFE4D4EE"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="8,2"/>
    <Setter Property="Margin" Value="0,0,6,4"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
</Style>

<Style x:Key="HeaderFilterChipCloseStyle" TargetType="Button">
    <Setter Property="Content" Value="×"/>
    <Setter Property="Foreground" Value="#FF6B7280"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="6,0,0,0"/>
    <Setter Property="MinWidth" Value="16"/>
    <Setter Property="MinHeight" Value="16"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="ToolTip" Value="Снять фильтр"/>
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="Transparent" Padding="2,0">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="#FF5B2C83"/>
                        <Setter TargetName="Bd" Property="Background" Value="#FFE4D4EE"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

<Style x:Key="HeaderFilterClearAllStyle" TargetType="Button">
    <Setter Property="Content" Value="Сбросить"/>
    <Setter Property="Foreground" Value="#FF5B2C83"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="4,2"/>
    <Setter Property="Margin" Value="2,0,0,4"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Visibility" Value="Collapsed"/>
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="Button">
                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
    <Style.Triggers>
        <DataTrigger Binding="{Binding HeaderFilters.HasMultiple}" Value="True">
            <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
    </Style.Triggers>
</Style>

<DataTemplate x:Key="HeaderFilterSummaryTemplate">
<DockPanel Margin="0,0,0,4">
    <DockPanel.Style>
        <Style TargetType="DockPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HeaderFilters.IsActive}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </DockPanel.Style>

    <Button DockPanel.Dock="Right"
            Style="{StaticResource HeaderFilterClearAllStyle}"
            Command="{Binding HeaderFilters.ClearCommand}"/>

    <ItemsControl ItemsSource="{Binding HeaderFilters.Active}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Style="{StaticResource HeaderFilterChipStyle}"
                        ToolTip="{Binding FullSummary}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" FontSize="12">
                            <Run Text="{Binding Title, Mode=OneWay}" Foreground="#FF6B7280"/>
                            <Run Text=": " Foreground="#FF6B7280"/>
                            <Run Text="{Binding Summary, Mode=OneWay}" Foreground="#FF3B1248"/>
                        </TextBlock>
                        <Button Style="{StaticResource HeaderFilterChipCloseStyle}"
                                Command="{Binding ClearCommand}"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</DockPanel>
</DataTemplate>
