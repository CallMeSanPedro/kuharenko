<!--
В шапке только значок. По нажатию открывается список или поле поиска.
xmlns:controls3 — тот же, что у MultiSelectComboBox.
Text="{Binding Title}" слушает фильтр. ColumnCheckFilterBehavior подставляет
ключ колонки (ИмяТипа_ИмяСвойства), поэтому язык меняется и когда в Add
передан русский ShortName, а не ключ.
StaysOpen остаётся True: иначе клик по выпадающему списку MultiSelectComboBox
закрывает сам фильтр. Скрытие по клику снаружи делает ColumnFilterPopup.
-->
<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:loc="clr-namespace:Store.Views.Localization"
              xmlns:filtering="clr-namespace:Store.Views.Filtering"
              xmlns:controls3="clr-namespace:DatumNode.Controls;assembly=DatumNode.Controls"
              x:Key="ColumnFilterHeaderTemplate">
    <Grid MinHeight="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="{Binding Title, Mode=OneWay}"
                   VerticalAlignment="Center"
                   Margin="0,0,6,0"/>

        <ToggleButton x:Name="FilterButton"
                      Grid.Column="1"
                      Width="16"
                      Height="16"
                      Padding="0"
                      BorderThickness="0"
                      Background="Transparent"
                      Cursor="Hand"
                      VerticalAlignment="Center"
                      ToolTip="{Binding [Column_Filter], Source={x:Static loc:Translation.Instance}, FallbackValue=Фильтр, TargetNullValue=Фильтр}">
            <Path Data="M 0,0 L 10,0 L 6.2,4.6 L 6.2,9 L 3.8,9 L 3.8,4.6 Z"
                  Width="10"
                  Height="9"
                  Stretch="Uniform">
                <Path.Style>
                    <Style TargetType="Path">
                        <Setter Property="Fill" Value="#94A3B8"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Fill" Value="#1B3F6F"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Path.Style>
            </Path>
        </ToggleButton>

        <Popup PlacementTarget="{Binding ElementName=FilterButton}"
               Placement="Bottom"
               StaysOpen="True"
               AllowsTransparency="True"
               filtering:ColumnFilterPopup.ClosesOnOutsideClick="True"
               IsOpen="{Binding IsChecked, ElementName=FilterButton, Mode=TwoWay}">
            <Border Background="White"
                    BorderBrush="#D5DEE9"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8"
                    Margin="0,4,0,0">
                <StackPanel>
                    <controls3:MultiSelectComboBox MinWidth="180"
                        EmptyText="Все"
                        AddAllItem="True"
                        ItemsSource="{Binding Options}"
                        SelectedItems="{Binding SelectedItems, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding IsCheckList, Converter={x:Static controls3:BooleanToVisibilityConverter.Instance}}" />
                    <TextBox MinWidth="180"
                        Height="28"
                        Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding ShowsText, Converter={x:Static controls3:BooleanToVisibilityConverter.Instance}}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ApplyCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button MinWidth="72"
                        Height="28"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Left"
                        Content="{Binding [Column_Apply], Source={x:Static loc:Translation.Instance}, FallbackValue=Найти, TargetNullValue=Найти}"
                        Command="{Binding ApplyCommand}"
                        Visibility="{Binding IsServerText, Converter={x:Static controls3:BooleanToVisibilityConverter.Instance}}" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</DataTemplate>
