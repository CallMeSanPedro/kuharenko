<!--
  Дефолтная тема — линейные иконки цвета шапки:
  <ResourceDictionary Source="pack://application:,,,/Store.Views;component/Icons/TreeIcons.Default.xaml"/>

  Современная тема — цветные, ближе к текущему дереву:
  <ResourceDictionary Source="pack://application:,,,/Store.Views;component/Icons/TreeIcons.Modern.xaml"/>

  Ключи в обоих словарях одинаковые, подключайте один.
-->
<!--
  xmlns:theming="clr-namespace:Store.Views.Theming"
  TypeStoreToImageConverter больше не нужен: SetResourceReference обновляет рисунок при смене темы.
-->
<Image Height="17"
       Width="17"
       SnapsToDevicePixels="True"
       theming:TreeIcon.Type="{Binding Path=Item.Dopinfo}"/>

