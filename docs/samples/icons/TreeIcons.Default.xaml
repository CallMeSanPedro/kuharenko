                <GeometryDrawing Brush="#00FFFFFF" Geometry="M0,0 H24 V24 H0 Z"/>
                <GeometryDrawing Pen="{StaticResource TreeIcon.Pen}"
                                 Geometry="M13.48,4.97 A3.7,3.7 0 1 0 18.43,5.62 M13.32,10.91 L6.2,18"/>
                <GeometryDrawing Pen="{StaticResource TreeIcon.Pen}">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="5.3,19" RadiusX="1.85" RadiusY="1.85"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

