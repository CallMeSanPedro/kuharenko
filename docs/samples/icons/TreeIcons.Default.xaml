<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Дефолтная тема. Линейные иконки 24×24 цвета шапки #0F2D5B.
        В дереве Image 16×16, Source="{StaticResource TreeIcon.*}".
        Подключать вместе с Theme.Default, не вместе со словарём Modern: ключи совпадают.
    -->
    <SolidColorBrush x:Key="TreeIcon.Stroke" x:Shared="False" Color="#0F2D5B"/>
    <Pen x:Key="TreeIcon.Pen" x:Shared="False"
         Brush="{StaticResource TreeIcon.Stroke}"
         Thickness="1.8"
         StartLineCap="Round"
         EndLineCap="Round"
         LineJoin="Round"/>

    <!-- Технический узел -->
    <DrawingImage x:Key="TreeIcon.TechnicalNode">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#00FFFFFF" Geometry="M0,0 H24 V24 H0 Z"/>
                <GeometryDrawing Pen="{StaticResource TreeIcon.Pen}"
                                 Geometry="M12,9.9 V5.1 M12,14.1 V18.9 M9.9,12 H5.1 M14.1,12 H18.9"/>
                <GeometryDrawing Brush="{StaticResource TreeIcon.Stroke}" Geometry="M12,12 m-2.15,0 a2.15,2.15 0 1,0 4.3,0 a2.15,2.15 0 1,0 -4.3,0"/>
                <GeometryDrawing Brush="{StaticResource TreeIcon.Stroke}" Geometry="M12,3.3 m-1.7,0 a1.7,1.7 0 1,0 3.4,0 a1.7,1.7 0 1,0 -3.4,0"/>
                <GeometryDrawing Brush="{StaticResource TreeIcon.Stroke}" Geometry="M12,20.7 m-1.7,0 a1.7,1.7 0 1,0 3.4,0 a1.7,1.7 0 1,0 -3.4,0"/>
                <GeometryDrawing Brush="{StaticResource TreeIcon.Stroke}" Geometry="M3.3,12 m-1.7,0 a1.7,1.7 0 1,0 3.4,0 a1.7,1.7 0 1,0 -3.4,0"/>
                <GeometryDrawing Brush="{StaticResource TreeIcon.Stroke}" Geometry="M20.7,12 m-1.7,0 a1.7,1.7 0 1,0 3.4,0 a1.7,1.7 0 1,0 -3.4,0"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

