<!-- Отдельные кнопки одной высоты. Общей рамки нет. -->
<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <RadioButton Content="Остатки"
                 GroupName="StoreDeviceMode"
                 IsChecked="{Binding ShowBalance, Mode=TwoWay}"
                 Style="{DynamicResource ModeButtonStyle}"/>
    <RadioButton Content="Серийные"
                 GroupName="StoreDeviceMode"
                 IsChecked="{Binding ShowSerials, Mode=TwoWay}"
                 Style="{DynamicResource ModeButtonStyle}"/>
    <Button Content="← К остатку"
            Margin="8,0,0,0"
            Style="{DynamicResource BackToBalanceButtonStyle}"/>
    <Button Content="Показать серийные"
            Margin="8,0,0,0"
            Style="{DynamicResource ShowSerialsButtonStyle}"/>
</StackPanel>
