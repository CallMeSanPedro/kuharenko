<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime"
                    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:controls="clr-namespace:DatumNode.Controls;assembly=DatumNode.Controls">

    <system:String x:Key="Store.CurrentTheme">Default</system:String>

    <!-- 1. Базовая цветовая палитра приложения (дефолтные цвета системы) -->
    <SolidColorBrush x:Key="HeaderBarBg" Color="#0F2D5B"/>
    <SolidColorBrush x:Key="HeaderBarText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderBarMuted" Color="#C7D2E8"/>

    <SolidColorBrush x:Key="PageBg" Color="#F4F7FB"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#E2E8F0"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>

    <SolidColorBrush x:Key="Accent" Color="#1B3F6F"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#E8F1FB"/>
    <SolidColorBrush x:Key="InputBorder" Color="#CBD5E1"/>

    <SolidColorBrush x:Key="Tab.IdleForeground" Color="#64748B"/>
    <SolidColorBrush x:Key="Tab.SelectedForeground" Color="#1B3F6F"/>
    <SolidColorBrush x:Key="Tab.SelectedUnderline" Color="#1B3F6F"/>

    <!-- Таблицы -->
    <SolidColorBrush x:Key="DataGrid.HeaderBg" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="DataGrid.SelectedRowBg" Color="#E8F1FB"/>
    <SolidColorBrush x:Key="DataGrid.HoverRowBg" Color="#F1F5F9"/>

    <!-- Дерево навигации -->
    <SolidColorBrush x:Key="Tree.SelectedBg" Color="#E8F1FB"/>
    <SolidColorBrush x:Key="Tree.SelectedText" Color="#1B3F6F"/>

    <!-- 2. Базовый стиль карточек: наследует стандартный MainContentBorders -->
    <Style x:Key="MainContentBorders" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- 3. Базовый стиль вкладок (стандартный MahApps / базовый стиль приложения) -->
    <Style TargetType="TabItem" BasedOn="{StaticResource MahApps.Styles.TabItem}">
        <Setter Property="Foreground" Value="{DynamicResource Tab.IdleForeground}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- 4. Базовый стиль кнопок -->
    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style x:Key="StatusBadge" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <SolidColorBrush x:Key="ColumnFilter.PopupBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ColumnFilter.PopupBorder" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="ColumnFilter.Icon" Color="#94A3B8"/>
    <SolidColorBrush x:Key="ColumnFilter.IconActive" Color="#1B3F6F"/>

    <Style x:Key="ColumnFilter.Title" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    <Style x:Key="ColumnFilter.Button" TargetType="ToggleButton">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ColumnFilter.Icon}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ColumnFilter.IconActive}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ColumnFilter.Popup" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ColumnFilter.PopupBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColumnFilter.PopupBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Width" Value="240"/>
        <Setter Property="MaxHeight" Value="320"/>
    </Style>
    <Style x:Key="ColumnFilter.Search" TargetType="TextBox">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColumnFilter.PopupBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="ColumnFilter.SelectAll" TargetType="CheckBox">
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="ColumnFilter.Option" TargetType="CheckBox">
        <Setter Property="Margin" Value="0,2"/>
    </Style>
    <Style x:Key="ColumnFilter.Reset" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    </Style>
</ResourceDictionary>
