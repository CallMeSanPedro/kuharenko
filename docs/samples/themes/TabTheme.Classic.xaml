<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <system:String x:Key="Store.UiTheme">Classic</system:String>

    <!-- Шапка (классический тёмно-синий) -->
    <SolidColorBrush x:Key="HeaderBarBg" Color="#1E3A5F"/>
    <SolidColorBrush x:Key="HeaderBarText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderBarMuted" Color="#D1D5DB"/>

    <!-- Страница и карточки -->
    <SolidColorBrush x:Key="PageBg" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#D1D5DB"/>

    <!-- Тексты -->
    <SolidColorBrush x:Key="TextPrimary" Color="#111827"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#4B5563"/>

    <!-- Акценты (сдержанный серый / антрацит) -->
    <SolidColorBrush x:Key="Accent" Color="#374151"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="InputBorder" Color="#9CA3AF"/>

    <!-- Вкладки контента -->
    <SolidColorBrush x:Key="Tab.IdleForeground" Color="#4B5563"/>
    <SolidColorBrush x:Key="Tab.SelectedForeground" Color="#111827"/>
    <SolidColorBrush x:Key="Tab.SelectedUnderline" Color="#374151"/>

    <!-- Таблицы -->
    <SolidColorBrush x:Key="DataGrid.HeaderBg" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="DataGrid.SelectedRowBg" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="DataGrid.HoverRowBg" Color="#F3F4F6"/>

    <!-- Дерево навигации -->
    <SolidColorBrush x:Key="Tree.SelectedBg" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="Tree.SelectedText" Color="#111827"/>
</ResourceDictionary>
