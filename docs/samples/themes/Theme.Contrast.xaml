<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime"
                    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:controls="clr-namespace:DatumNode.Controls;assembly=DatumNode.Controls">

    <system:String x:Key="Store.CurrentTheme">Contrast</system:String>

    <!-- 1. Цветовая палитра Contrast (яркий синий акцент, чистый белый и глубокий черный) -->
    <SolidColorBrush x:Key="HeaderBarBg" Color="#0A1E3D"/>
    <SolidColorBrush x:Key="HeaderBarText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderBarMuted" Color="#93C5FD"/>

    <SolidColorBrush x:Key="PageBg" Color="#EDF2F7"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#CBD5E1"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#000000"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#475569"/>

    <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="InputBorder" Color="#94A3B8"/>

    <SolidColorBrush x:Key="Tab.IdleForeground" Color="#475569"/>
    <SolidColorBrush x:Key="Tab.SelectedForeground" Color="#2563EB"/>
    <SolidColorBrush x:Key="Tab.SelectedUnderline" Color="#2563EB"/>

    <!-- Таблицы -->
    <SolidColorBrush x:Key="DataGrid.HeaderBg" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="DataGrid.SelectedRowBg" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="DataGrid.HoverRowBg" Color="#EFF6FF"/>

    <!-- Дерево навигации -->
    <SolidColorBrush x:Key="Tree.SelectedBg" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="Tree.SelectedText" Color="#1E40AF"/>

    <!-- 2. Форма карточек: современные скругления 12px -->
    <Style x:Key="MainContentBorders" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- 3. Вкладки-сегмент: общий контур, активный пункт залит акцентом -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="mah:TabControlHelper.Underlined" Value="None"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ColumnDefinition0"/>
                            <ColumnDefinition x:Name="ColumnDefinition1" Width="0"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="RowDefinition0" Height="Auto"/>
                            <RowDefinition x:Name="RowDefinition1" Height="*"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="HeaderPanel"
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="0,2,0,6"
                                Background="{DynamicResource CardBg}"
                                BorderBrush="{DynamicResource InputBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabNavigation="Local"/>
                        </Border>
                        <Border x:Name="ContentPanel"
                                Grid.Row="1"
                                Grid.Column="0"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="TabStripPlacement" Value="Bottom">
                            <Setter TargetName="HeaderPanel" Property="Grid.Row" Value="1"/>
                            <Setter TargetName="HeaderPanel" Property="Margin" Value="0,6,0,2"/>
                            <Setter TargetName="ContentPanel" Property="Grid.Row" Value="0"/>
                            <Setter TargetName="RowDefinition0" Property="Height" Value="*"/>
                            <Setter TargetName="RowDefinition1" Property="Height" Value="Auto"/>
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Left">
                            <Setter TargetName="ColumnDefinition0" Property="Width" Value="Auto"/>
                            <Setter TargetName="ColumnDefinition1" Property="Width" Value="*"/>
                            <Setter TargetName="HeaderPanel" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="HeaderPanel" Property="Grid.Row" Value="0"/>
                            <Setter TargetName="HeaderPanel" Property="Margin" Value="0,2,6,0"/>
                            <Setter TargetName="ContentPanel" Property="Grid.Column" Value="1"/>
                            <Setter TargetName="ContentPanel" Property="Grid.Row" Value="0"/>
                            <Setter TargetName="RowDefinition0" Property="Height" Value="*"/>
                            <Setter TargetName="RowDefinition1" Property="Height" Value="0"/>
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Right">
                            <Setter TargetName="ColumnDefinition0" Property="Width" Value="*"/>
                            <Setter TargetName="ColumnDefinition1" Property="Width" Value="Auto"/>
                            <Setter TargetName="HeaderPanel" Property="Grid.Column" Value="1"/>
                            <Setter TargetName="HeaderPanel" Property="Grid.Row" Value="0"/>
                            <Setter TargetName="HeaderPanel" Property="Margin" Value="6,2,0,0"/>
                            <Setter TargetName="ContentPanel" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="ContentPanel" Property="Grid.Row" Value="0"/>
                            <Setter TargetName="RowDefinition0" Property="Height" Value="*"/>
                            <Setter TargetName="RowDefinition1" Property="Height" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:TabControl" BasedOn="{StaticResource {x:Type TabControl}}"/>

    <Style TargetType="TabItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="{DynamicResource InputBorder}"
                            BorderThickness="0,0,1,0"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="HeaderText"
                                          ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{DynamicResource Tab.IdleForeground}"
                                          TextElement.FontSize="12"
                                          TextElement.FontWeight="Normal"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="HeaderText" Property="TextElement.Foreground" Value="{DynamicResource HeaderBarText}"/>
                            <Setter TargetName="HeaderText" Property="TextElement.FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                            <Setter TargetName="HeaderText" Property="TextElement.Foreground" Value="{DynamicResource TextSecondary}"/>
                            <Setter TargetName="HeaderText" Property="TextElement.FontWeight" Value="Normal"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 4. Форма кнопок -->
    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <SolidColorBrush x:Key="Badge.SuccessBg" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="Badge.SuccessFg" Color="#166534"/>
    <SolidColorBrush x:Key="Badge.NeutralBg" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="Badge.NeutralFg" Color="#334155"/>
    <SolidColorBrush x:Key="Badge.InfoBg" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="Badge.InfoFg" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="Badge.WarningBg" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="Badge.WarningFg" Color="#92400E"/>

    <Style x:Key="StatusBadge" TargetType="Border">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource Badge.NeutralBg}"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="TextElement.FontSize" Value="12"/>
        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Badge.NeutralFg}"/>
        <Style.Triggers>
            <Trigger Property="Tag" Value="Success">
                <Setter Property="Background" Value="{DynamicResource Badge.SuccessBg}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Badge.SuccessFg}"/>
            </Trigger>
            <Trigger Property="Tag" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource Badge.WarningBg}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Badge.WarningFg}"/>
            </Trigger>
            <Trigger Property="Tag" Value="Info">
                <Setter Property="Background" Value="{DynamicResource Badge.InfoBg}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Badge.InfoFg}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <SolidColorBrush x:Key="ColumnFilter.PopupBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ColumnFilter.PopupBorder" Color="#93C5FD"/>
    <SolidColorBrush x:Key="ColumnFilter.Icon" Color="#64748B"/>
    <SolidColorBrush x:Key="ColumnFilter.IconActive" Color="#0A1E3D"/>

    <!-- Чипы и кнопки фильтра: цвет шапки #0A1E3D. -->
    <SolidColorBrush x:Key="HeaderFilter.ChipBg" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="HeaderFilter.ChipBorder" Color="#93C5FD"/>
    <SolidColorBrush x:Key="HeaderFilter.ChipTitle" Color="#475569"/>
    <SolidColorBrush x:Key="HeaderFilter.ChipValue" Color="#0A1E3D"/>
    <SolidColorBrush x:Key="HeaderFilter.Accent" Color="#0A1E3D"/>
    <SolidColorBrush x:Key="HeaderFilter.AccentHoverBg" Color="#93C5FD"/>

    <Style x:Key="ModeButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource CardBg}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource HeaderFilter.ChipBorder}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HeaderFilter.Accent}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource HeaderFilter.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource HeaderBarText}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HeaderFilter.ChipBg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModeActionButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource HeaderFilter.Accent}"/>
        <Setter Property="Background" Value="{DynamicResource CardBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HeaderFilter.ChipBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HeaderFilter.AccentHoverBg}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HeaderFilter.Accent}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource HeaderFilter.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource HeaderBarText}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HeaderFilter.ChipBg}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource HeaderFilter.ChipBorder}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BackToBalanceButtonStyle" TargetType="Button" BasedOn="{StaticResource ModeActionButtonStyle}"/>
    <Style x:Key="ShowSerialsButtonStyle" TargetType="Button" BasedOn="{StaticResource ModeActionButtonStyle}"/>

    <Style x:Key="ColumnFilter.Title" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="ColumnFilter.Button" TargetType="ToggleButton">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource ColumnFilter.Icon}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ColumnFilter.IconActive}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ColumnFilter.Popup" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ColumnFilter.PopupBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColumnFilter.PopupBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Width" Value="240"/>
        <Setter Property="MaxHeight" Value="320"/>
    </Style>
    <Style x:Key="ColumnFilter.Search" TargetType="TextBox">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColumnFilter.PopupBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="ColumnFilter.SelectAll" TargetType="CheckBox">
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="ColumnFilter.Option" TargetType="CheckBox">
        <Setter Property="Margin" Value="0,2"/>
    </Style>
    <Style x:Key="ColumnFilter.Reset" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
</ResourceDictionary>
