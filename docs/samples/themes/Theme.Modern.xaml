<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime"
                    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:controls="clr-namespace:DatumNode.Controls;assembly=DatumNode.Controls">

    <system:String x:Key="Store.CurrentTheme">Modern</system:String>

    <!-- 1. Цветовая палитра Modern (Calm corporate) -->
    <SolidColorBrush x:Key="HeaderBarBg" Color="#0F2D5B"/>
    <SolidColorBrush x:Key="HeaderBarText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderBarMuted" Color="#C7D2E8"/>

    <SolidColorBrush x:Key="PageBg" Color="#F4F7FB"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#E2E8F0"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>

    <SolidColorBrush x:Key="Accent" Color="#1B3F6F"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#E8F1FB"/>
    <SolidColorBrush x:Key="InputBorder" Color="#CBD5E1"/>

    <SolidColorBrush x:Key="Tab.IdleForeground" Color="#64748B"/>
    <SolidColorBrush x:Key="Tab.SelectedForeground" Color="#1B3F6F"/>
    <SolidColorBrush x:Key="Tab.SelectedUnderline" Color="#1B3F6F"/>

    <!-- Таблицы -->
    <SolidColorBrush x:Key="DataGrid.HeaderBg" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="DataGrid.SelectedRowBg" Color="#E8F1FB"/>
    <SolidColorBrush x:Key="DataGrid.HoverRowBg" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="DataGrid.Line" Color="#D5DEE9"/>

    <!-- Бейджи значений. Неизвестное значение остаётся нейтральным. -->
    <SolidColorBrush x:Key="Badge.SuccessBg" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="Badge.SuccessFg" Color="#166534"/>
    <SolidColorBrush x:Key="Badge.NeutralBg" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="Badge.NeutralFg" Color="#475569"/>
    <SolidColorBrush x:Key="Badge.InfoBg" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="Badge.InfoFg" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="Badge.WarningBg" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="Badge.WarningFg" Color="#92400E"/>

    <!-- Дерево навигации -->
    <SolidColorBrush x:Key="Tree.SelectedBg" Color="#E8F1FB"/>
    <SolidColorBrush x:Key="Tree.SelectedText" Color="#1B3F6F"/>

    <!-- 2. Форма карточек: современные скругления 12px -->
    <Style x:Key="MainContentBorders" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- 3. Форма вкладок: чистый плоский стиль (текст + черта снизу) -->
    <Style TargetType="TabItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Tab.IdleForeground}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <DockPanel LastChildFill="True">
                            <Rectangle x:Name="Underline"
                                       DockPanel.Dock="Bottom"
                                       Height="2"
                                       Margin="0,6,0,0"
                                       Fill="Transparent"/>
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.FontFamily="{StaticResource TabItemFontFamily}"
                                              TextElement.FontSize="{StaticResource NavigationFontSize}"
                                              TextElement.FontWeight="SemiBold"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Underline" Property="Fill" Value="{DynamicResource Tab.SelectedUnderline}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Tab.SelectedForeground}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Tab.SelectedForeground}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource Tab.SelectedForeground}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 4. Форма кнопок -->
    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <!-- 5. Таблица: без вертикальных линий между ячейками, строка отделена нижней границей -->
    <Style x:Key="ModernDataGridColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource DataGrid.HeaderBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="64"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DataGrid.Line}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SeparatorBrush" Value="Transparent"/>
        <Setter Property="SeparatorVisibility" Value="Collapsed"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <Thumb x:Name="PART_LeftHeaderGripper"
                               HorizontalAlignment="Left"
                               Width="8"
                               Background="Transparent"
                               Opacity="0"/>
                        <Thumb x:Name="PART_RightHeaderGripper"
                               HorizontalAlignment="Right"
                               Width="8"
                               Background="Transparent"
                               Opacity="0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernDataGridColumnHeader}"/>

    <Style x:Key="ModernDataGridCell" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell" BasedOn="{StaticResource ModernDataGridCell}"/>

    <Style x:Key="ModernDataGridRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DataGrid.Line}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DataGrid.HoverRowBg}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource DataGrid.SelectedRowBg}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True"/>
                    <Condition Property="Selector.IsSelectionActive" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource DataGrid.SelectedRowBg}"/>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRow}"/>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RowBackground" Value="White"/>
        <Setter Property="AlternatingRowBackground" Value="White"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="HorizontalGridLinesBrush" Value="Transparent"/>
        <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeight" Value="38"/>
        <Setter Property="ColumnHeaderHeight" Value="64"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource ModernDataGridColumnHeader}"/>
        <Setter Property="CellStyle" Value="{StaticResource ModernDataGridCell}"/>
        <Setter Property="RowStyle" Value="{StaticResource ModernDataGridRow}"/>
    </Style>

    <!-- Фильтр колонки: кнопка в шапке и выпадающий список флажков. -->
    <SolidColorBrush x:Key="ColumnFilter.PopupBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ColumnFilter.PopupBorder" Color="#D5DEE9"/>
    <SolidColorBrush x:Key="ColumnFilter.Icon" Color="#94A3B8"/>
    <SolidColorBrush x:Key="ColumnFilter.IconActive" Color="#1B3F6F"/>

    <Style x:Key="ColumnFilter.Title" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="ColumnFilter.Button" TargetType="ToggleButton">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource ColumnFilter.Icon}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ColumnFilter.IconActive}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ColumnFilter.Popup" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ColumnFilter.PopupBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColumnFilter.PopupBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Width" Value="240"/>
        <Setter Property="MaxHeight" Value="320"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="ColumnFilter.Search" TargetType="TextBox">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColumnFilter.PopupBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource ColumnFilter.PopupBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <Style x:Key="ColumnFilter.SelectAll" TargetType="CheckBox">
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="ColumnFilter.Option" TargetType="CheckBox">
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <Style x:Key="ColumnFilter.Reset" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Плашка красится по тону (Tag: Success, Neutral, Warning, Info), не по тексту ячейки. -->
    <Style x:Key="StatusBadge" TargetType="Border">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource Badge.NeutralBg}"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextElement.FontSize" Value="12"/>
        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Badge.NeutralFg}"/>
        <Style.Triggers>
            <Trigger Property="Tag" Value="Success">
                <Setter Property="Background" Value="{DynamicResource Badge.SuccessBg}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Badge.SuccessFg}"/>
            </Trigger>
            <Trigger Property="Tag" Value="Neutral">
                <Setter Property="Background" Value="{DynamicResource Badge.NeutralBg}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Badge.NeutralFg}"/>
            </Trigger>
            <Trigger Property="Tag" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource Badge.WarningBg}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Badge.WarningFg}"/>
            </Trigger>
            <Trigger Property="Tag" Value="Info">
                <Setter Property="Background" Value="{DynamicResource Badge.InfoBg}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Badge.InfoFg}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
