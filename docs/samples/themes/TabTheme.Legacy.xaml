<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <system:String x:Key="Store.UiTheme">Legacy</system:String>

    <!-- Шапка (как в старом дизайне: темно-серо-синяя под текстуру) -->
    <SolidColorBrush x:Key="HeaderBarBg" Color="#1F2833"/>
    <SolidColorBrush x:Key="HeaderBarText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderBarMuted" Color="#D1D5DB"/>

    <!-- Страница и карточки (старый светло-серый ERP фон) -->
    <SolidColorBrush x:Key="PageBg" Color="#EFEFEF"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#999999"/>

    <!-- Тексты -->
    <SolidColorBrush x:Key="TextPrimary" Color="#000000"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#333333"/>

    <!-- Акценты (WinForms / Metro default синий) -->
    <SolidColorBrush x:Key="Accent" Color="#0072C6"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#CDE6F7"/>
    <SolidColorBrush x:Key="InputBorder" Color="#ABADB3"/>

    <!-- Вкладки контента (старый синий шрифт на активном табе) -->
    <SolidColorBrush x:Key="Tab.IdleForeground" Color="#000000"/>
    <SolidColorBrush x:Key="Tab.SelectedForeground" Color="#0066CC"/>
    <SolidColorBrush x:Key="Tab.SelectedUnderline" Color="#0066CC"/>

    <!-- Таблицы (стандартные цвета сетки ERP) -->
    <SolidColorBrush x:Key="DataGrid.HeaderBg" Color="#E4E4E4"/>
    <SolidColorBrush x:Key="DataGrid.SelectedRowBg" Color="#CDE6F7"/>
    <SolidColorBrush x:Key="DataGrid.HoverRowBg" Color="#DFEEF9"/>

    <!-- Дерево навигации -->
    <SolidColorBrush x:Key="Tree.SelectedBg" Color="#CDE6F7"/>
    <SolidColorBrush x:Key="Tree.SelectedText" Color="#000000"/>
</ResourceDictionary>
