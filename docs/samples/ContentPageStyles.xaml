<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime"
                    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:controls="clr-namespace:DatumNode.Controls;assembly=DatumNode.Controls"
                    xmlns:views="clr-namespace:Store.Views">
    <system:Double x:Key="MahApps.Font.Size.TabItem">13</system:Double>
    <system:Double x:Key="NavigationFontSize">13</system:Double>
    <system:Double x:Key="MahApps.Font.Size.Button">12</system:Double>

    <FontFamily x:Key="ExpanderFontFamily">CALIBRIZ.TTF#Calibri</FontFamily>
    <FontFamily x:Key="TabItemFontFamily">CALIBRIZ.TTF#Calibri</FontFamily>
    <FontFamily x:Key="DefaultFontFamily">CALIBRIZ.TTF#Calibri</FontFamily>
    <FontFamily x:Key="MahApps.Fonts.Family.Control">CALIBRIZ.TTF#Calibri</FontFamily>

    <SolidColorBrush x:Key="HeaderBarBg" Color="#0F2D5B"/>
    <SolidColorBrush x:Key="HeaderBarText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderBarMuted" Color="#C7D2E8"/>
    <SolidColorBrush x:Key="PageBg" Color="#F4F7FB"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
    <SolidColorBrush x:Key="Accent" Color="#1B3F6F"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#E8F1FB"/>
    <SolidColorBrush x:Key="InputBorder" Color="#CBD5E1"/>

    <!-- Цвета вкладок контента. Меняются шаблоном стиля из шапки. -->
    <SolidColorBrush x:Key="Tab.IdleForeground" Color="#64748B"/>
    <SolidColorBrush x:Key="Tab.SelectedForeground" Color="#1B3F6F"/>
    <SolidColorBrush x:Key="Tab.SelectedUnderline" Color="#1B3F6F"/>

    <!-- ******CONTENT PAGE STYLES****** -->
    <!-- ******************************* -->

    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="ToolBar" BasedOn="{StaticResource {x:Type ToolBar}}">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style TargetType="TabControl" BasedOn="{StaticResource MahApps.Styles.TabControl}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="mah:TabControlHelper.Underlined" Value="None"/>
    </Style>

    <Style TargetType="controls:TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="HeaderTabScrollButton" TargetType="RepeatButton">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource HeaderBarText}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border x:Name="Bg" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#20FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Шапка: одна линия вкладок. Если не влезает, слева и справа появляются стрелки, как у обычного TabControl. -->
    <Style x:Key="HeaderMenuTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="mah:TabControlHelper.Underlined" Value="None"/>
        <Setter Property="views:HeaderTabScroll.IsEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <RepeatButton x:Name="PART_ScrollLeft"
                                      Grid.Column="0"
                                      Style="{StaticResource HeaderTabScrollButton}"
                                      Visibility="Collapsed">
                            <Path Data="M 6,1 L 1,7 L 6,13"
                                  Stroke="{StaticResource HeaderBarText}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="7"
                                  Height="14"/>
                        </RepeatButton>
                        <ScrollViewer x:Name="PART_HeaderScroll"
                                      Grid.Column="1"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      CanContentScroll="False"
                                      Focusable="False"
                                      Background="Transparent"
                                      Padding="0"
                                      BorderThickness="0">
                            <TabPanel IsItemsHost="True"
                                      Background="Transparent"
                                      VerticalAlignment="Stretch"
                                      HorizontalAlignment="Center"/>
                        </ScrollViewer>
                        <RepeatButton x:Name="PART_ScrollRight"
                                      Grid.Column="2"
                                      Style="{StaticResource HeaderTabScrollButton}"
                                      Visibility="Collapsed">
                            <Path Data="M 1,1 L 6,7 L 1,13"
                                  Stroke="{StaticResource HeaderBarText}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="7"
                                  Height="14"/>
                        </RepeatButton>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HeaderMenuTabItem" TargetType="TabItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource HeaderBarMuted}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="MinHeight" Value="52"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <DockPanel LastChildFill="True">
                            <Rectangle x:Name="Underline"
                                       DockPanel.Dock="Bottom"
                                       Height="2"
                                       Fill="Transparent"/>
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.FontFamily="{StaticResource TabItemFontFamily}"
                                              TextElement.FontSize="{StaticResource NavigationFontSize}"
                                              TextElement.FontWeight="SemiBold"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Underline" Property="Fill" Value="{StaticResource HeaderBarText}"/>
                            <Setter Property="Foreground" Value="{StaticResource HeaderBarText}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource HeaderBarText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}">
        <Setter Property="Margin" Value="0"/>
    </Style>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource MahApps.Styles.MenuItem}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FontSize" Value="11.5"/>
    </Style>
</ResourceDictionary>
