<!--
Кнопка меню шапки. Не класть внутрь левого или правого StackPanel:
при узком окне колонка Auto обрезается справа и кнопка уходит с экрана.

Вставить последним соседом корневого Grid шапки (поверх внутренней сетки с Margin="0,0,48,0").
Полная разметка: MainView.Header.snippet.xaml
-->
<Menu Style="{StaticResource HeaderHamburgerMenu}"
      HorizontalAlignment="Right"
      VerticalAlignment="Center"
      Panel.ZIndex="1">
    <MenuItem Style="{StaticResource HeaderHamburgerItem}">
        <MenuItem Header="Выбор стиля"
                  Style="{StaticResource HeaderDropdownMenuItem}">
            <MenuItem Header="По умолчанию (Default)"
                      Tag="Default"
                      Click="ThemeMenuItem_OnClick"
                      Style="{StaticResource HeaderDropdownMenuItem}"/>
            <MenuItem Header="Современный (Modern)"
                      Tag="Modern"
                      Click="ThemeMenuItem_OnClick"
                      Style="{StaticResource HeaderDropdownMenuItem}"/>
            <MenuItem Header="Контрастный (Contrast)"
                      Tag="Contrast"
                      Click="ThemeMenuItem_OnClick"
                      Style="{StaticResource HeaderDropdownMenuItem}"/>
            <MenuItem Header="Старый исходный (Legacy)"
                      Tag="Legacy"
                      Click="ThemeMenuItem_OnClick"
                      Style="{StaticResource HeaderDropdownMenuItem}"/>
        </MenuItem>
    </MenuItem>
</Menu>
