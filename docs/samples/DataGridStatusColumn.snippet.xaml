<!--
Подпись и тон разделены.
Text — то, что видит пользователь.
Tag — результат конвертера по коду статуса, не по строке на экране.
Коды в StatusToneConverter замените на фактические значения поля.
-->
<DataGridTemplateColumn xmlns:loc="clr-namespace:Store.Views.Localization"
                        Header="{Binding [Column_Condition], Source={x:Static loc:Translation.Instance}, FallbackValue=Состояние, TargetNullValue=Состояние}"
                        Width="120">
    <DataGridTemplateColumn.CellTemplate>
        <DataTemplate>
            <Border Style="{DynamicResource StatusBadge}"
                    Tag="{Binding ConditionCode, Converter={StaticResource StatusToneConverter}}">
                <TextBlock Text="{Binding ConditionName}"/>
            </Border>
        </DataTemplate>
    </DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>

<DataGridTemplateColumn xmlns:loc="clr-namespace:Store.Views.Localization"
                        Header="{Binding [Column_OperationStatus], Source={x:Static loc:Translation.Instance}, FallbackValue=Статус эксплуатации, TargetNullValue=Статус эксплуатации}"
                        Width="150">
    <DataGridTemplateColumn.CellTemplate>
        <DataTemplate>
            <Border Style="{DynamicResource StatusBadge}"
                    Tag="{Binding ExploitationStatusCode, Converter={StaticResource StatusToneConverter}}">
                <TextBlock Text="{Binding ExploitationStatusName}"/>
            </Border>
        </DataTemplate>
    </DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
