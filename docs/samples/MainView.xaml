<controls:UserView x:Class="Store.Views.MainView"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:controls="clr-namespace:DatumNode.Controls;assembly=DatumNode.Controls"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                   xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                   xmlns:input="clr-namespace:System.Windows.Input;assembly=DatumNode.Controls"
                   xmlns:viewModels1="clr-namespace:Store.Main.ViewModels;assembly=Store.ViewModels"
                   xmlns:oebs="clr-namespace:Store.ViewModels.Oebs;assembly=Store.ViewModels"
                   xmlns:main="clr-namespace:Store.ViewModels.Main;assembly=Store.ViewModels"
                   xmlns:initUzel3="clr-namespace:Store.ViewModels.InitUzel;assembly=Store.ViewModels"
                   xmlns:viewModels="clr-namespace:Store.ViewModels;assembly=Store.ViewModels"
                   xmlns:audit="clr-namespace:Store.ViewModels.Audit;assembly=Store.ViewModels"
                   mc:Ignorable="d"
                   d:DataContext="{d:DesignInstance viewModels:MainViewModel}"
                   x:Name="View">

    <controls:UserView.Resources>
        <initUzel3:UzelsViewModel x:Key="UzelsViewModel"/>
        <controls:DataContextProxy x:Key="DataContextProxy"/>
        <controls:DialogDirector x:Key="Uzel" Margin="0,0,20,0" VerticalAlignment="Center"
                                 Refresh="False"
                                 Title="Выберите узел"
                                 Operation="Select"
                                 OKButtonContent="Выбрать"
                                 CancelButtonContent="Закрыть"
                                 ApplyCommand="{Binding Source={StaticResource UzelsViewModel}, Path=SaveCurUzelCommand}"
                                 ViewModel="{StaticResource UzelsViewModel}"
                                 TargetViewModel="{Binding Path=UzelsMasterViewModel.MasterViewModel}">
            <controls:DialogDirector.Properties>
                <controls:PropertyBinding
                    SourceProperty="{Binding Source={StaticResource UzelsViewModel}, Path=CurrentContainer.Item}"
                    TargetProperty="{Binding Source={StaticResource DataContextProxy}, Path=DataSource.UzelsMasterViewModel.MasterViewModel.CurrentItem, Mode=TwoWay}"/>
            </controls:DialogDirector.Properties>
        </controls:DialogDirector>

        <controls:DialogDirector x:Key="EquipMasterViewModel" Operation="View">
            <controls:DialogDirector.ViewModel>
                <main:EquipMasterViewModel/>
            </controls:DialogDirector.ViewModel>
        </controls:DialogDirector>

        <controls:DialogDirector x:Key="StoreReportsListViewModel" Operation="View">
            <controls:DialogDirector.ViewModel>
                <main:StoreReportsListViewModel/>
            </controls:DialogDirector.ViewModel>
        </controls:DialogDirector>

        <controls:DialogDirector x:Key="OebsCommandsViewModel" Operation="View">
            <controls:DialogDirector.ViewModel>
                <oebs:OebsCommandsViewModel/>
            </controls:DialogDirector.ViewModel>
        </controls:DialogDirector>

        <controls:DialogDirector x:Key="StoreReferenceListMasterDetailViewModel" Operation="View">
            <controls:DialogDirector.ViewModel>
                <viewModels1:StoreReferenceListMasterDetailViewModel/>
            </controls:DialogDirector.ViewModel>
        </controls:DialogDirector>

        <controls:DialogDirector x:Key="AuditViewModel" Operation="View">
            <controls:DialogDirector.ViewModel>
                <audit:AuditViewModel/>
            </controls:DialogDirector.ViewModel>
        </controls:DialogDirector>

        <SolidColorBrush x:Key="HeaderBarBg" Color="#0F2D5B"/>
        <SolidColorBrush x:Key="HeaderBarText" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="HeaderBarMuted" Color="#C7D2E8"/>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LinksMainMenuStyle}">
            <Setter Property="Foreground" Value="{StaticResource HeaderBarText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="HeaderTabItemStyle" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource HeaderBarMuted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <DockPanel LastChildFill="True">
                                <Rectangle x:Name="Underline"
                                           DockPanel.Dock="Bottom"
                                           Height="2"
                                           Fill="Transparent"/>
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Underline" Property="Fill" Value="{StaticResource HeaderBarText}"/>
                                <Setter Property="Foreground" Value="{StaticResource HeaderBarText}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource HeaderBarText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </controls:UserView.Resources>

    <Grid Background="{StaticResource HeaderBarBg}" MinHeight="52">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Левый блок: продукт, версия, узел, статус -->
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="12,0,16,0">
            <TextBlock x:Name="AppLogotype"
                       Style="{StaticResource AppLogotypeStyle}"
                       Foreground="{StaticResource HeaderBarText}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       Text="{Binding AppLogotype}"
                       ToolTipService.ToolTip="{Binding Path=AppConfig.ProgramTitle}"/>
            <TextBlock x:Name="AppText"
                       Text="{Binding CurrentVersion}"
                       Style="{StaticResource HeaderTextStyle}"
                       Opacity="0.85"
                       Margin="0,0,16,0"/>
            <Button x:Name="BtnUzel"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Style="{StaticResource MainMenuButton}"
                    Command="{Binding Path=DialogCommand}"
                    CommandParameter="{StaticResource Uzel}"
                    Margin="0,0,12,0"
                    Cursor="Hand">
                <TextBlock Foreground="{StaticResource HeaderBarText}"
                           FontSize="13"
                           Text="{Binding Path=UzelsMasterViewModel.MasterViewModel.CurrentItem}"
                           ToolTipService.ToolTip="{Binding Path=UzelsMasterViewModel.MasterViewModel.CurrentItem.RightInfo}"/>
            </Button>
            <ContentControl Background="Transparent"
                            MouseRightButtonUp="ContentControl_MouseRightButtonUp"
                            IsTabStop="False"
                            VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ButtonBlackStyle}"
                            Padding="0"
                            Foreground="{StaticResource HeaderBarMuted}"
                            Opacity="0.9"
                            VerticalAlignment="Center"
                            IsTabStop="False"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Left"
                            Width="Auto"
                            Command="{Binding Path=CloseAllRequestsCommand}"
                            Content="{Binding Path=StatusText, Mode=OneWay}"
                            ToolTipService.ToolTip="{Binding Path=Requests}"/>
                    <controls:LoadingIndicator Padding="0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource HeaderBarText}"
                                               Visibility="{Binding Path=Status, Converter={x:Static controls:StatusToVisibilityConverter.Instance}}"/>
                </StackPanel>
            </ContentControl>
        </StackPanel>

        <!-- Центр: пункты основного меню -->
        <StackPanel x:Name="StackPanel"
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Orientation="Horizontal">
            <TabControl x:Name="LinksBorder"
                        Style="{StaticResource MainTabControl}"
                        ItemContainerStyle="{StaticResource HeaderTabItemStyle}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Margin="0"
                        Foreground="{StaticResource HeaderBarMuted}"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Left"
                        mah:TabControlHelper.UnderlinePlacement="Bottom"
                        mah:TabControlHelper.Underlined="None">
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="SelectionChanged">
                        <input:EventToCommand x:Name="EventToCommand"
                                              Command="{Binding ElementName=View, Path=DataContext.DialogCommand}"
                                              CommandParameter="{Binding ElementName=LinksBorder, Path=SelectedItem.Tag}"/>
                    </b:EventTrigger>
                </b:Interaction.Triggers>
                <TabItem Header="Склад" Tag="{StaticResource EquipMasterViewModel}"/>
                <TabItem Header="Справочники" Tag="{StaticResource StoreReferenceListMasterDetailViewModel}"/>
                <TabItem Header="Отчёты" Tag="{StaticResource StoreReportsListViewModel}"/>
                <TabItem Header="Интеграция"
                         Tag="{StaticResource OebsCommandsViewModel}"
                         Visibility="{Binding Path=CanMenuOebs, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}"/>
                <TabItem Header="Аудит"
                         Tag="{StaticResource AuditViewModel}"
                         Visibility="{Binding Path=CanMenuAudit, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}"/>
            </TabControl>
        </StackPanel>

        <!-- Правый блок: пользователь, помощь, копирайт -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="12,0,16,0">
            <Button Style="{StaticResource ButtonAccentStyle}"
                    Content="{StaticResource IconUser}"
                    ContentTemplate="{StaticResource IconTemplate}"
                    IsEnabled="False"
                    Background="Transparent"
                    BorderThickness="0"/>
            <TextBlock x:Name="UserLabel"
                       VerticalAlignment="Center"
                       Style="{StaticResource HeaderTextStyle}"
                       Text="{Binding Path=User, TargetNullValue=Не авторизован}"/>
            <Button Style="{StaticResource ButtonAccentStyle}"
                    Content="{StaticResource IconHelps}"
                    ContentTemplate="{StaticResource IconTemplate}"
                    IsEnabled="False"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"/>
            <TextBlock x:Name="label1"
                       VerticalAlignment="Center"
                       Style="{StaticResource HeaderTextStyle}">
                <Hyperlink x:Name="HbInstrBtn"
                           FontWeight="Normal"
                           TextDecorations="None"
                           TargetName="_blank"
                           Foreground="{StaticResource HeaderBarText}"
                           Click="Hyperlink1_OnClick">Помощь</Hyperlink>
            </TextBlock>
            <TextBlock x:Name="InfoLabel"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Opacity="0.8"
                       Foreground="{StaticResource HeaderBarText}"
                       Margin="10,0,0,0"
                       Visibility="Hidden"
                       ToolTipService.ToolTip="{Binding Path=LastRequests}"
                       MouseLeftButtonUp="InfoLabel_MouseLeftButtonUp"/>
            <TextBlock x:Name="label2"
                       Margin="16,0,0,0"
                       Style="{StaticResource HeaderTextStyle}"
                       Opacity="0.85">
                <Hyperlink Foreground="{StaticResource HeaderBarMuted}"
                           FontWeight="Normal"
                           TextDecorations="None"
                           Click="Hyperlink_OnClick">© ООО "Техноград плюс"</Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</controls:UserView>
